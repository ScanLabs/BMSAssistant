<!DOCTYPE HTML><html>
<head>
  <title>SmartBMS WiFi</title>    
  <style>
body {
 min-width: 310px;
 max-width: 1000px;
 height: 400px;
 margin: 0 auto;
 font-family: "Lato", sans-serif;
}
h2 {
 font-family: Arial;
 font-size: 2.5rem;
 text-align: center;
}
.tablink{background:#e0e0e0;color:#333;float:left;border:none;border-radius:10px;cursor:pointer;padding:6px 12px;font-size:11px;font-weight:600;width:20%%;margin:3px 0;text-align:center;transition:background .25s,transform .25s,box-shadow .25s;box-shadow:0 1px 2px rgba(0,0,0,.08);}
.tablink:hover{background:#d5d5d5;transform:translateY(-2px);box-shadow:0 2px 4px rgba(0,0,0,.12);}
.tablink.active{background:#00978f;color:#fff;transform:translateY(-2px);box-shadow:0 2px 4px rgba(0,0,0,.15);}
.tabcontent{color:#000;display:none;padding:20px;text-align:center}
.btn-group button {
  background-color: #04AA6D; 
  border: 1px solid green; 
  border-radius: 12px;
  margin: 4px 2px;
  color: white; 
  padding: 10px 24px; 
  cursor: pointer; 
  float: left; 
}
.btn-group:after {
  content: "";
  clear: both;
  display: table;
}
.btn-group button:not(:last-child) {
  border-right: none; 
}
.btn-group button:hover {
  background-color: #3e8e41;
}
#unLicensed {color: red;background-color: transparent;text-decoration:none;}
</style>  
  <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<script>
function submitMessage() {
  modBusConfig(0);
  setTimeout(function(){ document.location.reload(false); }, 2000);
}
function modBusConfig( extcomp ){ //1-extract 0-compress & send
  let modBusCfg=%mbCfg%;  
  let tmpStr="";
  if ( modBusCfg&1<<5 ) tmpStr="Active"; else tmpStr="Sleeping";
  document.getElementById("ServStat").innerHTML=tmpStr;
  if ( modBusCfg&1<<6 ) tmpStr="Active"; else tmpStr="Sleeping";
  if ( modBusCfg&1<<7 ) tmpStr="Missing/Bad json";
  document.getElementById("CliStat").innerHTML=tmpStr; 
  if ( extcomp ){
    document.getElementById("mbSEn").checked=(modBusCfg & 0x01)?1:0;
    document.getElementById("mbSWF").checked=(modBusCfg & 0x02)?1:0;
    document.getElementById("mbCEn").checked=(modBusCfg & 0x04)?1:0;
  }else{
    modBusCfg = document.getElementById("mbSEn").checked?(1<<0):0;
    modBusCfg+= document.getElementById("mbSWF").checked?(1<<1):0;
    modBusCfg+= document.getElementById("mbCEn").checked?(1<<2):0;

    var urltocall="/get_mb?mbCfg="+modBusCfg;
    xmlhttp=new XMLHttpRequest();
    xmlhttp.open("GET", urltocall, false);
    xmlhttp.send();
  }
}
function openTab(color){
  var i,tabcontent,tablinks,boxName;
  tabcontent=document.getElementsByClassName("tabcontent");
  for (i=0; i < tabcontent.length; i++){
    tabcontent[i].style.display="none";
  }
  tablinks=document.getElementsByClassName("tablink");
  for (i=0; i < tablinks.length; i++){
    tablinks[i].style.backgroundColor="";
  }
  boxName = document.getElementById("defaultOpen").textContent;
  document.getElementById(boxName).style.display="block";
  document.getElementById("defaultOpen").style.backgroundColor=color;
}
function checkMQTT(){
  if ( %mqttPublishEnable% && (document.getElementById("mbSEn").checked == true || document.getElementById("mbCEn").checked == true) )
    alert("Due to low memory resource it is NOT recommended to have MQTT and MODBUS both active");
}
</script>
<body>
  <button class="tablink" onclick="window.location.href='/';">Status</button> 
  <button class="tablink" onclick="window.location.href='/batt';">Battery</button>
  <button class="tablink" onclick="window.location.href='/graph';">Monitor</button>
  <button class="tablink" onclick="window.location.href='/config';"  id="defaultOpen">Settings</button>
  <button class="tablink" onclick="window.location.href='/fwupgrade';">Upgrade</button>
  <div id="Settings" class="tabcontent"></div>
  <div style='margin:15px;'><br><center><b>MODBUS TCP CONFIG</center></b>
  <center><font id="fwStat"></font></center><br> 
  <hr><br>
  <table style="height: 100%%;" border="0">
  <tbody>
  <tr style="height: 40px;">
  <td style="width: 45%%; height: 40px;"><form action="/get_mb" target="hidden-form">
  <span title="Enable MODBUS TCP">MODBUS TCP SERVER: <input id="mbSEn" name="mbSEn" type="checkBox" /><br /><span title="Swap H-L Words on Float">SWAP FLOAT: <input id="mbSWF" name="mbSWF" type="checkBox" /></span></span></td>
  <td style="width: 33%%; height: 40px;">STATUS: <span id="ServStat"></span></td>
  <td style="width: 33%%; height: 40px;"><a href="mbtcpInfo">ModBus REGISTER MAP</a></td>
  </tr>
  <tr style="height: 51px;">
  <td style="height: 51px;"><form action="/get_mb" target="hidden-form"><br /><span title="Enable MODBUS TCP">MODBUS TCP CLIENT: <input id="mbCEn" name="mbCEn" type="checkBox" /></span><br /><br /></form></td>
  <td style="height: 51px;">STATUS: <span id="CliStat"></td>
  <td style="height: 51px;"><a href="mbCliInfo">ModBus CLIENT Json</a></td>
  </tr>
  <tr style="height: 21px;">
  <td style="height: 21px;"><input type="submit" value="Submit" onclick="submitMessage()">
  </form></td>
  <td style="height: 21px;">&nbsp;</td>
  <td style="height: 21px;">&nbsp;</td>
  </tr>
  </tbody>
  </table>  
  <hr><br>  
  <div class="btn-group">
    <button onclick="window.location.href='config';">BACK to CONFIG</button>
    <button onclick="window.location.href='https://www.dalybmswifi.com/images/';"> MODBUSTCP MANUAL </button>
  </div>
  <iframe style="display:none" name="hidden-form"></iframe>
  </div>
  <script>
    openTab('red');
    if ( !%fwStatus% ){
      document.getElementById("fwStat").innerHTML = "<br><a id=\"unLicensed\" href=\"license.html\"><b>ACTIVATE</b></a><br>";
     }
    modBusConfig(1);
  </script>
</body></html>

<!--FFILE-->
<!--HFILE:mqtt.html--> 
<!doctype html><html>
<head>
<title>SmartBMS WiFi</title>
<style>body{min-width:310px;max-width:1000px;height:400px;margin:0 auto;font-family:Lato,sans-serif}h2{font-family:Arial;font-size:2.5rem;text-align:center}.tablink{background:#e0e0e0;color:#333;float:left;border:none;border-radius:10px;cursor:pointer;padding:6px 12px;font-size:11px;font-weight:600;width:20%%;margin:3px 0;text-align:center;transition:background .25s,transform .25s,box-shadow .25s;box-shadow:0 1px 2px rgba(0,0,0,.08)}.tablink:hover{background:#d5d5d5;transform:translateY(-2px);box-shadow:0 2px 4px rgba(0,0,0,.12)}.tablink.active{background:#00978f;color:#fff;transform:translateY(-2px);box-shadow:0 2px 4px rgba(0,0,0,.15)}.tabcontent{color:#000;display:none;padding:20px;text-align:center}.btn-group button{background-color:#04aa6d;border:1px solid green;border-radius:12px;margin:4px 2px;color:#fff;padding:10px 24px;cursor:pointer;float:left}.btn-group:after{content:"";clear:both;display:table}.btn-group button:not(:last-child){border-right:none}.btn-group button:hover{background-color:#3e8e41}#unLicensed{color:red;background-color:transparent;text-decoration:none}.pwd-box{position:relative;display:inline-block}.pwd-box input{padding-right:32px}.togglePwd{position:absolute;right:6px;top:50%%;transform:translateY(-50%%);cursor:pointer;user-select:none}.mqttBox{width:18px;height:18px;border-radius:4px;background:none;border:1px solid #333}.mqttBoxWrapper{display:flex;flex-direction:column;align-items:center;margin-right:10px;position:relative}.mqttLabel{font-size:11px;font-weight:700;margin-bottom:3px}.mqttBoxWrapper:hover .tooltip{opacity:1;visibility:visible;transform:translate(-50%%,-5px)}.tooltip{position:absolute;bottom:35px;left:50%%;transform:translateX(-50%%);background:#333;color:#fff;padding:4px 8px;border-radius:4px;font-size:11px;white-space:nowrap;opacity:0;visibility:hidden;transition:.2s ease;pointer-events:none;z-index:10}</style>
<meta name=viewport content="width=device-width,initial-scale=1">
</head>
<body>
<button class=tablink onclick='window.location.href="/"'>Status</button>
<button class=tablink onclick='window.location.href="/batt"'>Battery</button>
<button class=tablink onclick='window.location.href="/graph"'>Monitor</button>
<button class=tablink onclick='window.location.href="/config"' id=defaultOpen>Settings</button>
<button class=tablink onclick='window.location.href="/fwupgrade"'>Upgrade</button>
<div id=Settings class=tabcontent></div>
<div style=margin:15px><br><center><b>MQTT CONFIG</b></center>
<center><font id="fwStat"><br><a id=unLicensed href="license.html"><b>Sync with Server</b></a><br></font></center><br><hr>
<div style="display:flex;justify-content:center;align-items:center;gap:12px;margin:10px 0;">
    <div class="mqttBoxWrapper" style="display:flex;flex-direction:column;align-items:center;">
        <div class="mqttLabel">EN</div>
        <div id="boxEnabled" class="mqttBox"></div>
        <div class="tooltip">MQTT enabled</div>
    </div>
    <div class="mqttBoxWrapper" style="display:flex;flex-direction:column;align-items:center;">
        <div class="mqttLabel">CN</div>
        <div id="boxConnected" class="mqttBox"></div>
        <div class="tooltip">Broker Connected</div>
    </div>
    <div class="mqttBoxWrapper" style="display:flex;flex-direction:column;align-items:center;">
        <div class="mqttLabel">SB</div>
        <div id="boxSubscr" class="mqttBox"></div>
        <div class="tooltip">Subscribing Active</div>
    </div>
    <div class="mqttBoxWrapper" style="display:flex;flex-direction:column;align-items:center;">
        <div class="mqttLabel">TX</div>
        <div id="boxPub" class="mqttBox"></div>
        <div class="tooltip">Last Publish Status</div>
    </div>
    <div class="mqttBoxWrapper" style="display:flex;flex-direction:column;align-items:center;">
        <div class="mqttLabel">HA</div>
        <div id="boxHADisc" class="mqttBox"></div>
        <div class="tooltip">Home Assistant Disocvery Ready to be sent</div>
    </div>
    <input id="nextPub" readonly
           title="Seconds to next MQTT Publish"
           style="width:55px;text-align:center;border:1px solid #ccc;border-radius:6px">
</div>
<hr><br>
<div style="display:flex;justify-content:flex-start;gap:10px;margin-top:12px;">
    <button id="btnTestMQTT" disabled onclick='ws.send("testMQTT")'>Test MQTT</button>
    <button id="btnHADisc" disabled
        onclick='alert("HA Discovery will be sent within 30s"); ws.send("haDiscovery");'>
        Generate Home Assistant Discovery
    </button>
</div>
<br><hr><br>
<form action=/get_mqtt target=hidden-form>
<input type="hidden" id="mqttFlags" name="mqttPublishFlags" value=%mqttPublishFlags%>
MQTT Server:
<div class=pwd-box>
<input type=password name=mqttServer id=mS value=%mqttServer% maxlength=128 size=5 oninput=ckFieldSize()>
<span class=togglePwd onclick='togglePwd("mS",this)'><svg width=20 height=20 viewBox="0 0 24 24"><path fill=#444 d="M12 4.5C7 4.5 2.7 7.6 1 12c1.7 4.4 6 7.5 11 7.5s9.3-3.1 11-7.5c-1.7-4.4-6-7.5-11-7.5zm0 12.5a5 5 0 1 1 0-10 5 5 0 0 1 0 10z"/></svg></span>
</div><br>
MQTT PORT: <input type=number maxlength=4 max=65535 min=1 step=1 name=mqttPort value=%mqttPort%> Use TLS: <span title="Secure MQTT through TLS"><input type=checkBox name=mqttSec %mqttSec%></span><br>
MQTT User Name:
<div class=pwd-box>
<input type=password name=mqttUserName id=mUN value=%mqttUserName% maxlength=24 size=5 oninput=ckFieldSize()>
<span class=togglePwd onclick='togglePwd("mUN",this)'><svg width=20 height=20 viewBox="0 0 24 24"><path fill=#444 d="M12 4.5C7 4.5 2.7 7.6 1 12c1.7 4.4 6 7.5 11 7.5s9.3-3.1 11-7.5c-1.7-4.4-6-7.5-11-7.5zm0 12.5a5 5 0 1 1 0-10 5 5 0 0 1 0 10z"/></svg></span>
</div><br>
MQTT Password:
<div class=pwd-box>
<input type=password name=mqttPassword id=mP value=%mqttPassword% maxlength=24 size=5 oninput=ckFieldSize()>
<span class=togglePwd onclick='togglePwd("mP",this)'><svg width=20 height=20 viewBox="0 0 24 24"><path fill=#444 d="M12 4.5C7 4.5 2.7 7.6 1 12c1.7 4.4 6 7.5 11 7.5s9.3-3.1 11-7.5c-1.7-4.4-6-7.5-11-7.5zm0 12.5a5 5 0 1 1 0-10 5 5 0 0 1 0 10z"/></svg></span>
</div><br>
MQTT Client ID: <input name=mqttClientID id=mC value=%mqttClientID% maxlength=24 size=5 oninput=ckFieldSize()><br><br><hr>
<table><tbody>
<tr><td style=width:30%%>
<input type=hidden id=mqttJSON name=mqttJSON value=%mqttJSON%>
<span title="Enable MQTT">Enable MQTT: <input type=checkBox id=mqttPublishEnable name=mqttPublishEnable %mqttPublishEnable% onclick=checkModBusTCP()></span><br>
<span title="export MQTT data as json format type1=batteries as JSON array, type=batteries as list">Export as:<br>&emsp;Flat1<input type=checkBox id=mqttFLAT1 onclick=handleCheck(3)>&emsp;Json1<input type=checkBox id=mqttJSON1 onclick=handleCheck(1)>&emsp;Json2<input type=checkBox id=mqttJSON2 onclick=handleCheck(2)></span><br>
<span title="mqtt refresh time in seconds. MUST BE Larger than BMS Polling time">Publish Refresh [s] : <input type=number maxlength=3 max=600 min=5 step=5 name=mqttRefresh id=mqttRefresh value=%mqttRefresh% disabled></span><br>
<span title="Publish All Batteries [mV]">Publish Pack BATT : <input type=checkbox id=ShowBAT onclick=handleCheck(this)
tooltip_mqtt_soc="All Batteries comma separated"></span><br>
<span title="Publish All Resistances [mOhm]">Publish Pack RES : <input type=checkbox id=ShowRES onclick=handleCheck(this)
tooltip_mqtt_soc="All Resistances comma separated"></span><br>
<span title="Publish Status of Charge">Publish Pack SOC : <input type=checkBox id=ShowSOC onclick=handleCheck(this) tooltip_mqtt_soc="Status of Charge"></span><br>
<span title="Publish Battery Pack Power [W]">Publish Pack W : <input type=checkBox id=ShowPW onclick=handleCheck(this)></span><br>
<span title="Publish Battery Pack Voltage [mV]">Publish Pack V : <input type=checkBox id=ShowPV onclick=handleCheck(this)></span><br>
<span title="Publish Battery Pack Current [A]">Publish Pack I : <input type=checkBox id=ShowPA onclick=handleCheck(this)></span><br>
<span title="Publish Battery Balance Current [A]">Publish Balance I : <input type=checkBox id=ShowBA onclick=handleCheck(this)></span><br>
<span title="Publish batteries max delta [mV]">Publish Pack &#916V : <input type=checkBox id=ShowPCD onclick=handleCheck(this)></span><br>
<span title="Publish average batteries voltage [mV]">Publish Batt Average V : <input type=checkBox id=ShowAV onclick=handleCheck(this)></span><br>
<span title="Publish Battery Pack Temp [C]">Publish Pack Temp : <input type=checkBox id=ShowAT onclick=handleCheck(this)></span><br>
<span title="Publish BMS Alarms">Publish BMS Alarms Stream: <input type=checkBox id=ShowFails onclick=handleCheck(this)></span><br><br>
<span title="Publish Max SOC">Publish Max SOC : <input type=checkBox id=ShowMxSoc onclick=handleCheck(this)></span><br>
<span title="Publish Min VCell">Publish Min VCell : <input type=checkBox id=ShowMnVCel onclick=handleCheck(this)></span><br>
<span title="Publish Max VCell">Publish Max VCell : <input type=checkBox id=ShowMxVCel onclick=handleCheck(this)></span><br>
<span title="Publish Nominal Cap">Publish Nominal Cap : <input type=checkBox id=ShowNomCap onclick=handleCheck(this)></span><br>
<span title="Publish Residual Cap">Publish Residual Cap : <input type=checkBox id=ShowResCap onclick=handleCheck(this)></span><br>
<span title="Publish Cycle Cap">Publish Cycle Cap : <input type=checkBox id=ShowCyCap onclick=handleCheck(this)></span><br>
<span title="Publish All Temp">Publish All Temp : <input type=checkBox id=ShowAllTmp onclick=handleCheck(this)></span><br>
<span title="Publish All Mos status">Publish All MOS : <input type=checkBox id=ShowAllMos onclick=handleCheck(this)></span><br><br>

<input type=submit value=Submit onclick=submitMessage()><br>
</td>
<td style=width:20%%>&nbsp;</td>
<td><p id=dtext></p></td>
</tr>
</tbody></table>
</form><hr><br>
<div class=btn-group>
<button onclick='window.location.href="config"'>BACK to CONFIG</button>&emsp;&emsp;
<button onclick='window.location.href="IoTMQTTPanel"'>GENERATE IoTMQTT Panel CONFIG</button>
<button onclick='window.location.href="https://www.dalybmswifi.com/images/"'>MQTT MANUAL</button>
</div>
</div>
<iframe style=display:none name=hidden-form></iframe>
<script>
var mqttPubFlags=document.getElementById("mqttFlags").value 
const mqttMap = [
  "ShowBAT","ShowRES","ShowSOC","ShowPW","ShowPV","ShowPA","ShowBA",
  "ShowPCD","ShowAV","ShowAT","ShowFails","ShowExtra",
  "ShowMxSoc","ShowMnVCel","ShowMxVCel","ShowNomCap","ShowResCap",
  "ShowCyCap","ShowAllTmp","ShowAllMos"
].reduce((o,k,i)=>(o[k]=i,o),{});
const el = {};
["mqttJSON1","mqttJSON2","mqttFLAT1","mqttJSON",
 "ShowBAT","ShowRES","ShowSOC","ShowPW","ShowPV","ShowPA","ShowBA",
 "ShowPCD","ShowAV","ShowAT","ShowFails","ShowExtra",
 "ShowMxSoc","ShowMnVCel","ShowMxVCel","ShowNomCap","ShowResCap",
 "ShowCyCap","ShowAllTmp","ShowAllMos",
 "dtext","defaultOpen","btnTestMQTT","btnHADisc","nextPub","boxHADisc",
 "mqttRefresh","fwStat","mqttPublishEnable",
 "mS","mUN","mP","mC",
 "boxEnabled","boxConnected","boxPub","boxSubscr"
].forEach(id => el[id] = document.getElementById(id));
function getFlag(flagName) {
    const bit = mqttMap[flagName];
    return (mqttPubFlags & (1 << bit)) !== 0;
}
function setFlag(flagName, value) {
    const bit = mqttMap[flagName];
    if (value)
        mqttPubFlags |= (1 << bit);
    else
        mqttPubFlags &= ~(1 << bit);
    document.getElementById("mqttFlags").value = mqttPubFlags;
}
function loadFlagsIntoUI() {
    for (const flagName in mqttMap) {
        const e = el[flagName];
        if (e) e.checked = getFlag(flagName);
    }
}
function submitMessage(){
    setTimeout(function(){document.location.reload(false)},3000);
}
function openTab(c){
    var i,t,l,b;
    t = document.getElementsByClassName("tabcontent");
    for(i=0;i<t.length;i++) t[i].style.display="none";
    l = document.getElementsByClassName("tablink");
    for(i=0;i<l.length;i++) l[i].style.backgroundColor="";
    b = el.defaultOpen.textContent;
    document.getElementById(b).style.display = "block";
    el.defaultOpen.style.backgroundColor = c;
}
function testMQTTConnection(){
    var u="/testmqtt";
    xmlhttp=new XMLHttpRequest();
    xmlhttp.open("GET",u,false);
    xmlhttp.send();
    setTimeout(function(){location.reload()},2500);
}
function onloadJsoncheck(){
    el.mqttJSON1.checked=false;
    el.mqttJSON2.checked=false;
    if(el.mqttJSON.value==1){
        el.mqttJSON1.checked=true;
        el.mqttJSON2.checked=false;
        el.mqttFLAT1.checked=false;
    }
    if(el.mqttJSON.value==2){
        el.mqttJSON1.checked=false;
        el.mqttJSON2.checked=true;
        el.mqttFLAT1.checked=false;
    }
    if(el.mqttJSON.value==3){
        el.mqttJSON1.checked=false;
        el.mqttJSON2.checked=false;
        el.mqttFLAT1.checked=true;
    }
    handleCheck();
}
function handleCheck(cb){
    if (typeof cb === "number") {
        if (cb === 1) {
            el.mqttJSON2.checked = false;
            el.mqttFLAT1.checked = false;
            el.mqttJSON.value = 1;
        }
        if (cb === 2) {
            el.mqttJSON1.checked = false;
            el.mqttFLAT1.checked = false;
            el.mqttJSON.value = 2;
        }
        if (cb === 3) {
            el.mqttJSON1.checked = false;
            el.mqttJSON2.checked = false;
            el.mqttFLAT1.checked = true;
            el.mqttJSON.value = 3;
        }
    }
    if (!el.mqttJSON1.checked &&
        !el.mqttJSON2.checked &&
        !el.mqttFLAT1.checked)
        el.mqttJSON.value = 0;
    let j = "";
    if (el.mqttJSON.value == 0)
        j+="<b>PUBLISHED FLAT</b>&emsp;&emsp;Topic: NONE<br><br>";
    else if (el.mqttJSON.value == 3)
        j+="<b>PUBLISHED FLAT</b>&emsp;&emsp;Topic: <b><input type=\"text\" name=\"mqttJsonTopic\" value=\"%mqttJsonTopic%\" maxlength=\"19\" size=\"19\"></b><br><br>";
    else
        j+="<b>PUBLISHED JSON</b>&emsp;&emsp;Topic: <b><input type=\"text\" name=\"mqttJsonTopic\" value=\"%mqttJsonTopic%\" maxlength=\"19\" size=\"19\"></b><br><br>";

    if (el.ShowBAT.checked) {
        if (el.mqttJSON1.checked)
            j+="\"bat\": {\"0\": 2947,&emsp;....,&emsp;\"15\": 2949}";
        else if (el.mqttJSON2.checked)
            j+="\"b0\": 2947,<br>....,<br>\"b15\": 2949";
        else
            j+="\"BATT\"16;2947;....;2949";
    }
    if (el.ShowRES.checked) {
        j+="<br>";
        if (el.mqttJSON1.checked)
            j+="\"res\": {\"0\": 12,&emsp;....,&emsp;\"15\": 2}";
        else if (el.mqttJSON2.checked)
            j+="\"r0\": 12,<br>....,<br>\"r15\": 15";
        else
            j+="\"BRES\"16;2947;....;2949";
    }
    if (el.ShowSOC.checked)
        j+="<br>\"SOC\": 27";
    const flat = (el.mqttJSON.value == 0 || el.mqttJSON.value == 3);
    if (flat) {
        if (el.ShowPW.checked) j+="<br>\"PWATTS\": 42";
        if (el.ShowPV.checked) j+="<br>\"PMVOLT\": \"47.10\"";
        if (el.ShowPA.checked) j+="<br>\"PMAMPERE\": \"0.90\"";
        if (el.ShowPCD.checked) j+="<br>\"PDELTAV\": 6";
        if (el.ShowAV.checked) j+="<br>\"PAVERAGEMV\": \"2946.00\"";
        if (el.ShowAT.checked) j+="<br>\"PTEMP\": 10";
        if (el.ShowFails.checked) {
            j+="<br>\"PFAIL\": \"0,0,0,0,0,0,0\"";
            j+="<br>\"PFAIF\": \"1\"";
        }
    } else {
        if (el.ShowPW.checked) j+="<br>\"PWT\": 42";
        if (el.ShowPV.checked) j+="<br>\"PMV\": \"47.10\"";
        if (el.ShowPA.checked) j+="<br>\"PMA\": \"0.90\"";
        if (el.ShowBA.checked) j+="<br>\"BAC\": \"-1.60\"";
        if (el.ShowPCD.checked) j+="<br>\"PDV\": 6";
        if (el.ShowAV.checked) j+="<br>\"AMV\": \"2946.00\"";
        if (el.ShowAT.checked) j+="<br>\"TMP\": 10";
        if (el.ShowFails.checked) {
            j+="<br>\"ALM\": \"0,0,0,0,0,0,0\"";
            j+="<br>\"ALMF\": \"1\"";
        }
    }
    if (el.ShowMxSoc.checked) j+="<br><br>\"SCM\": \"88\"";
    if (el.ShowMnVCel.checked) j+="<br>\"MIC\": \"2920\"";
    if (el.ShowMxVCel.checked) j+="<br>\"MAC\": \"3540\"";
    if (el.ShowNomCap.checked) j+="<br>\"CAP\": \"200\"";
    if (el.ShowResCap.checked) j+="<br>\"RCP\": \"17\"";
    if (el.ShowCyCap.checked) j+="<br>\"CYC\": \"121\"";
    if (el.ShowAllTmp.checked) j+="<br>\"temp\":{\"tm\":280,\"t1\":267,\"t2\":275,\"t4\":276,\"t5\":276}";
    if (el.ShowAllMos.checked) j+="<br>\"mos\":{\"Ch\":1,\"Di\":1,\"Ba\":1}";
    el.dtext.innerHTML = j;
    if (cb instanceof HTMLElement) {
        setFlag(cb.id, cb.checked);
    }
}
function togglePwd(id, elBtn){
  const i = el[id];
  const eyeOpen='<svg width="20" height="20" viewBox="0 0 24 24"><path fill="#444" d="M12 4.5C7 4.5 2.7 7.6 1 12c1.7 4.4 6 7.5 11 7.5s9.3-3.1 11-7.5c-1.7-4.4-6-7.5-11-7.5zm0 12.5a5 5 0 1 1 0-10 5 5 0 0 1 0 10z"/></svg>';
  const eyeClosed='<svg width="20" height="20" viewBox="0 0 24 24"><path fill="#444" d="M12 4.5C7 4.5 2.7 7.6 1 12c1.7 4.4 6 7.5 11 7.5s9.3-3.1 11-7.5c-1.7-4.4-6-7.5-11-7.5zm0 12.5a5 5 0 1 1 0-10 5 5 0 0 1 0 10z"/><path stroke="#444" stroke-width="2" d="M3 3l18 18"/></svg>';
  if(i.type==="password"){ i.type="text"; elBtn.innerHTML=eyeClosed; }
  else{ i.type="password"; elBtn.innerHTML=eyeOpen; }
}
let ws;
let wsTimer=null;
function wsConnect(){
  ws = new WebSocket("ws://"+location.host+"/ws");
  ws.onopen = function(){
    wsTimer = setInterval(requestStatus,2000);
    el.btnTestMQTT.disabled = false;
    el.btnHADisc.disabled = false;
  };
  ws.onmessage = function(evt){
    console.log(evt.data);
    try{
      const d = JSON.parse(evt.data);

      setBox("boxEnabled", d.mqEn);
      setBox("boxConnected", d.mqCn);
      setBox("boxPub", d.mqLP);
      setBox("boxSubscr", d.mqSb);

      el.nextPub.value = d.mqNx;
      if (d.mqHA == 1) el.boxHADisc.style.background = "#00a000";
      else el.boxHADisc.style.background = "none";
     if (d.Syl == 1){ el.mqttRefresh.disabled = false; el.fwStat.innerHTML = "";}
     if (d.Syl == 0){ el.mqttRefresh.disabled = true; el.fwStat.innerHTML = "ENABLE FULL FEATURE";}
    }catch(e){}
  };
  ws.onclose = function(){
    clearInterval(wsTimer);
    setTimeout(wsConnect,2000);
    el.btnTestMQTT.disabled = true;
    el.btnHADisc.disabled = true;
  };
  ws.onerror = function(){
    setTimeout(function(){window.location.reload();},5000);
    el.btnTestMQTT.disabled = true;
    el.btnHADisc.disabled = true;
  };
}
function requestStatus(){
  if(ws && ws.readyState===1){
    ws.send("getMQTTStatus");
  }
}
function setBox(id,val){
  el[id].style.background = val ? "#00a000" : "#b00000";
}
function checkModBusTCP(){
  if((%mbCfg%&0x01) && el.mqttPublishEnable.checked==true)
    alert("MODBUS TCP is Enabled ! it is NOT recommended to have MQTT and MODBUS both active");
}
function ckFieldSize(){
  let s = el.mS.value,
      u = el.mUN.value,
      p = el.mP.value,
      c = el.mC.value;
  el.mS.size = s.length+1;
  el.mUN.size = u.length+1;
  el.mP.size = p.length+1;
  el.mC.size = c.length+1;
}
window.onload = function() {
  loadFlagsIntoUI();
  onloadJsoncheck();
  openTab('red');
  ckFieldSize();
  wsConnect();
};
window.addEventListener("error", function(e) {
    console.error("Errore globale:", e);
    setTimeout(() => {
        location.reload();
    }, 3000);
});
</script>
</body>
</html><!--FFILE-->
<!--HFILE:pushSafer.html--> 
<!DOCTYPE HTML><html>
<head>
  <title>SmartBMS WiFi</title>    
  <style>
    body {
     min-width: 310px;
     max-width: 1000px;
     height: 400px;
     margin: 0 auto;
     font-family: "Lato", sans-serif;
    }
    h2 {
     font-family: Arial;
     font-size: 2.5rem;
     text-align: center;
    }
    .tablink{background:#e0e0e0;color:#333;float:left;border:none;border-radius:10px;cursor:pointer;padding:6px 12px;font-size:11px;font-weight:600;width:20%%;margin:3px 0;text-align:center;transition:background .25s,transform .25s,box-shadow .25s;box-shadow:0 1px 2px rgba(0,0,0,.08);}
.tablink:hover{background:#d5d5d5;transform:translateY(-2px);box-shadow:0 2px 4px rgba(0,0,0,.12);}
.tablink.active{background:#00978f;color:#fff;transform:translateY(-2px);box-shadow:0 2px 4px rgba(0,0,0,.15);}
.tabcontent{color:#000;display:none;padding:20px;text-align:center}
    .btn-group button {
  background-color: #04AA6D; 
  border: 1px solid green; 
  border-radius: 12px;
  margin: 4px 2px;
  color: white; 
  padding: 10px 24px; 
  cursor: pointer; 
  float: left; 
    }
    .btn-group:after {
      content: "";
      clear: both;
      display: table;
    }
    .btn-group button:not(:last-child) {
      border-right: none; 
    }
    .btn-group button:hover {
      background-color: #3e8e41;
    }
    #unLicensed {color: red;background-color: transparent;text-decoration:none;}
  </style>  
  <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<script>
  function submitMessage() {
    setTimeout(function(){ document.location.reload(false); }, 3000);
  }
  function testPushSaferContext(){
    var checkPsID = document.forms["psForm"]["psID"].value;
    if( checkPsID  == "" || checkPsID == null){
      alert("Please enter a Valid Push Service ID - create an account @ www.pushsafer.com or www.pushover.com");
      return false;
    }
    if ( document.getElementById("psEn").checked == false && document.getElementById("poEn").checked == false){
      alert("Please Enable a PUSH Service before to test");
      return false;
    }
    return true;
  }
  function testPushSafer(cb){
    var urltocall = "/testPS?type=";
    if ( testPushSaferContext() == false )
      return;
    if ( cb == 1 || cb == 2)
      urltocall += cb; 
    else
      retun;
    xmlhttp=new XMLHttpRequest();
    xmlhttp.open("GET", urltocall, false);
    xmlhttp.send();
    alert("Push hopefully sent to your devices ;-) ");
    setTimeout(function(){location.reload();}, 2000);
  }
  function checkPS(source){
    if ( source == 0 ){
      document.getElementById("psEn").checked = false;
      document.getElementById("psUN").disabled = false;
    }
    if ( source == 1 ){
      document.getElementById("poEn").checked = false;
      document.getElementById("psUN").disabled = true;
    }
  }
  function openTab(color){
    var i,tabcontent,tablinks,boxName;
    tabcontent=document.getElementsByClassName("tabcontent");
    for (i=0; i < tabcontent.length; i++){
      tabcontent[i].style.display="none";
    }
    tablinks=document.getElementsByClassName("tablink");
    for (i=0; i < tablinks.length; i++){
      tablinks[i].style.backgroundColor="";
    }
    boxName = document.getElementById("defaultOpen").textContent;
    document.getElementById(boxName).style.display="block";
    document.getElementById("defaultOpen").style.backgroundColor=color;
  }
  function ckFieldSize() {
    document.getElementById("psUN").size = document.getElementById("psUN").value.length+1;
    document.getElementById("psID").size = document.getElementById("psID").value.length+1;
    document.getElementById("psMsg").size = document.getElementById("psMsg").value.length+1;
    document.getElementById("psTO").size = document.getElementById("psTO").value.length+1;
  }
  function showPwd(id){
  var inp;
  if (id==0) inp=document.getElementById("psUN");
  if (id==1) inp=document.getElementById("psID");
  if ( inp.type == "password") inp.type="text"; else inp.type="password";
}
</script>
<body>
  <button class="tablink" onclick="window.location.href='/';">Status</button> 
  <button class="tablink" onclick="window.location.href='/batt';">Battery</button>
  <button class="tablink" onclick="window.location.href='/graph';">Monitor</button>
  <button class="tablink" onclick="window.location.href='/config';" id="defaultOpen">Settings</button>
  <button class="tablink" onclick="window.location.href='/fwupgrade';">Upgrade</button>
  <div id="Settings" class="tabcontent"></div>
  <div style='margin:15px;'><br><center><b>PUSHSAFER CONFIG</center></b>
  <center><font id="fwStat"></font></center><br> 
  <hr><br>
  <table style="width: 100&#37 border-collapse: collapse;" border="0">
    <tbody>
      <tr>
        <td style="width: 70&#37;">
        <form name="psForm" action="/get_ps" target="hidden-form">
        <span title="Enable PUSHOVER">PUSHOVER: <input type="checkBox" id="poEn" name="poEn" %poEn% onclick="checkPS(0)"></span><br>
        <span title="Enable PUSHSAFER">PUSHSAFER: <input type="checkBox" id="psEn" name="psEn" %psEn% onclick="checkPS(1)"></span><br><br>
    	  <span title="Your UserName or UserKey">User ID: <input type="password" id="psUN" name="psUN" value="%psUN%" maxlength="30" size="5" oninput="ckFieldSize()" ></span>
        <span title="Show User Name"><input type="checkBox" id="pUsN" onclick="showPwd(0)"></span><br>
    	  <span title="Your KEY or Token">Private KEY: <input type="password" id="psID" name="psID" value="%psID%" maxlength="30" size="5" oninput="ckFieldSize()" ></span>
        <span title="Show Key or Token"><input type="checkBox" id="pKoT" onclick="showPwd(1)"></span><br>
    	  <span title="Push Title">Message: <input type="text" id="psMsg" name="psMsg" value="%psMsg%" maxlength="30" size="5" oninput="ckFieldSize()"></span><br>
    	  <span title="Send Push to a give device or group - refer to PushOver or PushSafer info">Send to: <input type="text" id="psTO" name="psTO" value="%psTO%" maxlength="10" size="5" oninput="ckFieldSize()" ></span><br><br>         
          <span title="Send daily Report at SunSet">SunSet Report: <input type="checkBox" id="psSDRSS" name="psSDRSS" %psSDRSS%></span><br>
          <span title="Send daily Report at SunRise">SunRise Report: <input type="checkBox" id="psSDRSR" name="psSDRSR" %psSDRSR%></span><br>
          <span title="Send daily Report at 100&#37 SOC">100&#37 SOC Report: <input type="checkBox" id="psSD100" name="psSD100" %psSD100%></span><br>
          <span title="Send daily Alarms">Alarm Report: <input type="checkBox" id="psSDALM" name="psSDALM" %psSDALM%></span><br>
          <span title="Send Same Alarm after n-minutes - set 1440 to send one type of alarm per day">Alarm Filter: <input type="number" id="psFIL" name="psFIL" value="%psFIL%" min="0" max="1440"></span><br>         
          <br><input type="submit" value="Submit" onclick="submitMessage()"><br><br>  
        </form></td>
  	<td style="width: 30&#37;">API Credits <b>%psCRED%</b><br><br>
        <button style="color: blue" onclick="testPushSafer(1);">Send TEST Daily Report NOW</button><br><br>
  	<button style="color: red" onclick="testPushSafer(2);">Send TEST Alarm Report NOW</button></td>
      </tr>
      </tbody>
  </table>
<hr><br>  
<div class="btn-group">
  <button onclick="window.location.href='config';">BACK to CONFIG</button>
  <button onclick="window.location.href='https://www.dalybmswifi.com/images/';"> PUSH SERVICE MANUALs </button>
</div>
  <iframe style="display:none" name="hidden-form"></iframe>
</div>
<script>
  openTab('red');
  if ( document.getElementById("poEn").checked == true )
    document.getElementById("psUN").disabled = false;
  else
    document.getElementById("psUN").disabled = true;
if ( !%fwStatus% ){
  document.getElementById("psSD100").disabled = true;
  document.getElementById("psSDALM").disabled = true;
  document.getElementById("psFIL").disabled = true;
  document.getElementById("fwStat").innerHTML = "<br><a id=\"unLicensed\" href=\"license.html\"><b>ACTIVATE</b></a><br>";
}
ckFieldSize();
</script>
</body>
</html>

<!--FFILE-->
<!--HFILE:SystemConfig.html--> 
<!DOCTYPE HTML><html>
<head>
  <title>ScanLabs SMART BMS DATA EXTRACTOR</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css">
  <style>
    body{min-width:310px;max-width:1000px;margin:0 auto;font-family:"Lato",sans-serif}
    h2{font-family:Arial;font-size:2.5rem;text-align:center}
    .ssidRow:hover{background:#ddd;cursor:pointer}
    .tablink{background:#e0e0e0;color:#333;float:left;border:none;border-radius:10px;cursor:pointer;padding:6px 12px;font-size:11px;font-weight:600;width:20%%;margin:3px 0;text-align:center;transition:background .25s,transform .25s,box-shadow .25s;box-shadow:0 1px 2px rgba(0,0,0,.08);}
    .tablink:hover{background:#d5d5d5;transform:translateY(-2px);box-shadow:0 2px 4px rgba(0,0,0,.12);}
    .tablink.active{background:#00978f;color:#fff;transform:translateY(-2px);box-shadow:0 2px 4px rgba(0,0,0,.15);}
    .tabcontent{display:none;padding:20px;text-align:center}
    .btn-group button{background:#04AA6D;border:1px solid green;border-radius:12px;margin:4px 2px;color:#fff;padding:10px 24px;cursor:pointer;float:left}
    .btn-group:after{content:"";clear:both;display:table}
    .btn-group button:hover{background:#3e8e41}
    #modalOverlay{position:fixed;top:0;left:0;width:100%%;height:100%%;background:rgba(0,0,0,0.5);display:none;justify-content:center;align-items:center;z-index:999}
    #modalBox{background:#fff;width:90%%;max-width:500px;height:70%%;border-radius:8px;overflow:hidden;display:flex;flex-direction:column}
    #map{flex:1}
    #closeBtn{padding:8px;background:#ddd;text-align:center;cursor:pointer}
    #unLicensed{color:red;background:transparent;text-decoration:none}
  </style>
  <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
  <script>
    let ssidTableArray=[%scanAP%];
    function submitMessage(){
      if(inPWD.value.length<8) inPWD.value="";
      if(ckSIP.checked){
        if(!ValidateNETaddress(IPAddr.value)||
           !ValidateNETaddress(SubNet.value)||
           !ValidateNETaddress(DGatw.value)) return;
      }
      setTimeout(()=>location.reload(),3000);
    }
    function submitMessageRB(){
      alert("System Rebooting please wait 10s :-)");
      setTimeout(()=>location='/',10000);
    }
    function submitMessageFR(form){
      setTimeout(()=>location='/',3000);
      form.submit();
    }
    function openTab(color){
      let t=document.getElementsByClassName("tabcontent");
      for(let i=0;i<t.length;i++) t[i].style.display="none";
      let l=document.getElementsByClassName("tablink");
      for(let i=0;i<l.length;i++) l[i].style.backgroundColor="";
      let b=defaultOpen.textContent;
      document.getElementById(b).style.display="block";
      defaultOpen.style.backgroundColor=color;
    }
    function syncDate(){
      let x=new XMLHttpRequest();
      x.open("GET","/SysDate?epoch="+Math.trunc(Date.now()/1000),false);
      x.send();
      submitMessage();
    }
    function ValidateNETaddress(ip){
      let r=/^(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$/;
      if(r.test(ip)) return true;
      alert("Invalid IP address!");
      return false;
    }
    function handleWiFiMode(){
      let t="&emsp;&emsp;&emsp;(WiFi ";
      let ip="",w="";oM="none";
      if(wifiMode.checked){
        handleAPModeSet(true);
        t+='Access Point <b>"SmartBMS.it"</b>)';
      }else{
        handleAPModeSet(false);
        t+="<b>Station</b> Mode)";
        ip="Current IP: <b>%curIP%</b><br>HTTP Port: <input type='number' min='80' max='65535' name='curPO' value='%curPO%' size='5'><br><br>";
        w="<img src='%weatherLink%' style='width:333px;height:80px;'><br><br>";
        oM="inline-block";
      }
      wifiModeAlert.innerHTML=t;
      currentIP_PORT.innerHTML=ip;
      weatherDiv.innerHTML=w;
      openMapBtn.style.display=oM;
    }
    function showPwd(){inPWD.type=(inPWD.type=="password")?"text":"password";}
    function scanSSID(){
      sscan.innerHTML="<br>**** SCANNING ACCESS POINT ****<br><br>";
      let x=new XMLHttpRequest();
      x.open("GET","/sscan",false);
      x.send();
      setTimeout(()=>location.reload(),4000);
    }
    function selectSSID(i){
      wifiMode.checked=false;
      handleWiFiMode();
      inSSID.value=ssidTableArray[i];
      if(ssidTableArray[i+2]=="0"){
        inPWD.style.visibility="hidden";
        inPWD.value="";
      }
      setTimeout(() => { sscan.innerHTML=""; }, 1000);
    }
    function populateSSID(){
      if(ssidTableArray.length==0) return;
      if(ssidTableArray.length%%4!=0) return;
      let t="<br>Click on SSID to Select<br><table border='2' style='border-collapse:collapse;width:60%%'><tr><td><b>SSID</b></td><td><b>CH</b></td><td><b>SEC</b></td><td><b>PW</b></td></tr>";
      for(let i=0;i<ssidTableArray.length;i+=4){
        t+="<tr class='ssidRow'><td><span onclick='selectSSID("+i+")'>"+ssidTableArray[i]+"</span></td><td>"+ssidTableArray[i+1]+"</td><td>"+(ssidTableArray[i+2]=="0"?"open":"enc")+"</td><td>"+ssidTableArray[i+3]+"%%</td></tr>";
      }
      t+="</table><br><br>";
      sscan.innerHTML=t;
    }
    function ckFieldSize(){
      inPWD.size=inPWD.value.length+1;
      inSSID.size=inSSID.value.length+1;
    }
    function handleInit(){
      handleDHCPClick();
      handleWiFiMode();
      populateSSID();
      ckFieldSize();
      setCoord(currentLat,currentLng);
    }
    function checkComma(l){
      let e=l?document.getElementsByName("inputLONGITUDE")[0]:document.getElementsByName("inputLATITUDE")[0];
      e.value=e.value.replace(/,/g,".");
    }
    function handleDHCPClick(){
      if(!ckSIP.checked){
        staticIP.innerHTML="";
        return;
      }
      staticIP.innerHTML="<table><tr><td>IP Address</td><td><input type='text' name='IPAddr' id='IPAddr' value='%IPAddr%'></td></tr><tr><td>Subnet</td><td><input type='text' name='IPSubNet' id='SubNet' value='%IPSubNet%'></td></tr><tr><td>Default GW</td><td><input type='text' name='IPDefGW' id='DGatw' value='%IPDefGW%'></td></tr></table><br>";
    }
    function handleAPModeSet(c){
      if(!c){
        if(!ckSIP.checked){
          staticIP.innerHTML="";
          inSSID.style.visibility="";
          ckSIP.style.visibility="";
        }else handleDHCPClick();
      }else{
        inSSID.style.visibility="hidden";
        ckSIP.style.visibility="hidden";
        staticIP.innerHTML="<table><tr><td>IP Address</td><td><input type='text' name='IPAddr' value='192.168.0.1'></td></tr><tr><td>Subnet</td><td><input type='text' name='IPSubNet' value='255.255.255.0'></td></tr><tr><td>Default GW</td><td><input type='text' name='IPDefGW' value='192.168.0.1'></td></tr></table><br>";
      }
    }
    function setCoord(lat,lon){
      document.getElementsByName("inputLATITUDE")[0].value=lat;
      document.getElementsByName("inputLONGITUDE")[0].value=lon;
    }
    function initMap(){
      map=L.map("map").setView([currentLat,currentLng],5);
      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",{maxZoom:19,attribution:"© OpenStreetMap"}).addTo(map);
      marker=L.marker([currentLat,currentLng]).addTo(map);
      map.on("click",e=>{
        currentLat=e.latlng.lat;
        currentLng=e.latlng.lng;
        setCoord(currentLat.toFixed(6),currentLng.toFixed(6));
        closeBtn.textContent="Lat: "+currentLat.toFixed(4)+" Lon: "+currentLng.toFixed(4)+" [Push to Set&Close]";
        marker.setLatLng(e.latlng);
      });
    }
    let currentLat=%inputLATITUDE%;
    let currentLng=%inputLONGITUDE%;
    let map=null,marker=null;
  </script>
</head>
<body onload="handleInit()">
  <button class="tablink" onclick="location.href='/'">Status</button>
  <button class="tablink" onclick="location.href='/batt'">Battery</button>
  <button class="tablink" onclick="location.href='/graph'">Monitor</button>
  <button class="tablink" onclick="location.href='/config'" id="defaultOpen">Settings</button>
  <button class="tablink" onclick="location.href='/fwupgrade'">Upgrade</button>
  <div id="Settings" class="tabcontent"></div>
  <div style="margin:15px">
    <br><center><b>Config File Version # %inputJVERSION%</b></center>
    <center><font id="fwStat"></font></center><br>
    <hr><br>
    <form action="/get_misc" target="hidden-form">
      WiFi Mode: AP <input type="checkbox" id="wifiMode" name="wifiMode" %wifiMode% onclick="handleWiFiMode()">
      <span id="wifiModeAlert"></span>
      <br>STATUS: %WStatus%<br>
      <br>SSID: <input type="text" name="inSSID" id="inSSID" value="%inSSID%" maxlength="32" size="5" oninput="ckFieldSize()">
      <input type="button" onclick="scanSSID()" value="SCAN"><br>
      <span id="sscan"></span>
      PASSPHRASE: <input type="password" id="inPWD" name="inPWD" value="%inPWD%" maxlength="64" size="5" oninput="ckFieldSize()">
      <input type="checkbox" onclick="showPwd()"><br>
      WiFi Power [dBm]: <input type="number" min="0" max="20" step="1" name="inputWiFiPower" value="%inputWiFiPower%" size="2"><br><br>
      <font id="currentIP_PORT"></font>
      HostName: <input type="text" name="HostName" id="HostName" value="%HostName%" maxlength="10" size="10"><br>
      Static IP: <input type="checkbox" name="staticIP" id="ckSIP" %staticIP% onclick="handleDHCPClick()"><br>
      <p id="staticIP"></p>
      Latitude: <input type="number" min="-90" max="90" step="0.0000001" name="inputLATITUDE" onblur="checkComma(0)">
      Longitude: <input type="number" min="-180" max="180" step="0.0000001" name="inputLONGITUDE" onblur="checkComma(1)">
      <button id="openMapBtn" type="button">Select Coordinates</button>
      <div id="modalOverlay">
        <div id="modalBox">
          <div id="map"></div>
          <div id="closeBtn">Set&Close *You will need to Submit*</div>
        </div>
      </div>
      <br>%getCurrentTime% <button type="button" onclick="syncDate()">Sync with PC</button>
      <br>Time Zone GMT+: <input type="number" name="inputTIMEZONE" min="-11" max="14" value="%inputTIMEZONE%">
      <br>Time 24h format: <input type="checkbox" id="input24" name="input24" %input24%><br><br>
      <p id="weatherDiv"></p>
      <input type="submit" value="Submit" onclick="submitMessage()"><br><br>
    </form>
    <hr>
    <div class="btn-group">
      <button onclick="location.href='misc'">MISC</button>
      <button onclick="location.href='mqtt'">MQTT</button>
      <button onclick="location.href='display'">DISPLAY</button>
      <button onclick="location.href='modbustcp'">MODBUSTCP</button>
      <button onclick="location.href='pushsafer'">NOTIFICATIONS</button>
      <button onclick="location.href='vUart'">UART TUNNEL</button>
      <button onclick="location.href='upload'">LOG&FILE</button>
      <button onclick="location.href='https://www.dalybmswifi.com/images/'">HELP</button>
      <button onclick="location.href='debug'">4 NERDS</button>
      <button onclick="location.href='https://www.dalybmswifi.com/donate/'">DONATE :-)</button>
    </div>
    <br><hr>
    <table><tr>
      <th>
        <form action="/get_RTF" target="hidden-formXX">
          <input type="hidden" name="SystemReboot">
          <input type="submit" value="System Restart" onclick="submitMessageRB()">
        </form>
      </th>
      <th>
        <form action="/get_RTF" target="hidden-formXY" onsubmit="return(confirm('Restore to factory?') ? submitMessageFR(this) : false)">
          <input type="hidden" name="RestoreToFactory">
          <input type="submit" value="** Factory Reset **">
        </form>
      </th>
    </tr></table>
  </div>
  <iframe style="display:none" name="hidden-form"></iframe>
  <iframe style="display:none" name="hidden-formXX"></iframe>
  <iframe style="display:none" name="hidden-formXY"></iframe>
  <script data-name="BMC-Widget" data-cfasync="false"
    src="https://cdnjs.buymeacoffee.com/1.0.0/widget.prod.min.js"
    data-id="scanlabs"
    data-description="Support me on Buy me a coffee!"
    data-message="Thank you so much for supporting my work, it truly means a lot !"
    data-color="#FF813F"
    data-position="Right"
    data-x_margin="18"
    data-y_margin="18"
    id="bmcWidget">
  </script>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const w = document.getElementById("bmcWidget");
      if (!w) return;
      w.setAttribute("data-position", "Right-Bottom");
    });
  </script>
  <script>
    openTab('red');
    if(!%fwStatus%){
      let f=document.getElementById("fwStat");
      if(f) f.innerHTML="<br><a id='unLicensed' href='license.html'><b>ACTIVATE</b></a><br>";
    }
    openMapBtn.onclick=function(){
      modalOverlay.style.display="flex";
      if(!map) initMap();
      setTimeout(()=>map.invalidateSize(),200);
    };
    closeBtn.onclick=function(){
      modalOverlay.style.display="none";
    };
  </script>
</body>
</html><!--FFILE-->
<!--HFILE:uploadiframe.html--> 
<!DOCTYPE HTML>
<head>
  <title>SmartBMS WiFi</title>    
  <style>
body {
 min-width: 310px;
 max-width: 1000px;
 height: 400px;
 margin: 0 auto;
 font-family: "Lato", sans-serif;
}
h2 {
 font-family: Arial;
 font-size: 2.5rem;
 text-align: center;
}
.tablink{background:#e0e0e0;color:#333;float:left;border:none;border-radius:10px;cursor:pointer;padding:6px 12px;font-size:11px;font-weight:600;width:20%%;margin:3px 0;text-align:center;transition:background .25s,transform .25s,box-shadow .25s;box-shadow:0 1px 2px rgba(0,0,0,.08);}
.tablink:hover{background:#d5d5d5;transform:translateY(-2px);box-shadow:0 2px 4px rgba(0,0,0,.12);}
.tablink.active{background:#00978f;color:#fff;transform:translateY(-2px);box-shadow:0 2px 4px rgba(0,0,0,.15);}
.tabcontent{color:#000;display:none;padding:20px;text-align:center}
.btn-group button {
  background-color: #04AA6D; 
  border: 1px solid green; 
  color: white; 
  padding: 10px 24px; 
  cursor: pointer; 
  float: left; 
}
.btn-group:after {
  content: "";
  clear: both;
  display: table;
}
.btn-group button:not(:last-child) {
  border-right: none; 
}
.btn-group button:hover {
  background-color: #3e8e41;
}
</style> 
  <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body>
  <button class="tablink" onclick="window.location.href='/';">Status</button> 
  <button class="tablink" onclick="window.location.href='/batt';">Battery</button>
  <button class="tablink" onclick="window.location.href='/graph';">Monitor</button>
  <button class="tablink" onclick="window.location.href='/config';">Settings</button>
  <button class="tablink" onclick="window.location.href='/fwupgrade';" id="defaultOpen">Upgrade</button>
  <div id="Upgrade" class="tabcontent"></div>
 <div style='margin:15px;'><iframe src="/update" width="100%%" height="400" style="border:none;"></iframe></div>
<script>
function openTab(color){
  var i,tabcontent,tablinks,boxName;
  tabcontent=document.getElementsByClassName("tabcontent");
  for (i=0; i < tabcontent.length; i++){
    tabcontent[i].style.display="none";
  }
  tablinks=document.getElementsByClassName("tablink");
  for (i=0; i < tablinks.length; i++){
    tablinks[i].style.backgroundColor="";
  }
  boxName = document.getElementById("defaultOpen").textContent;
  document.getElementById(boxName).style.display="block";
  document.getElementById("defaultOpen").style.backgroundColor=color;
}
openTab('red');
</script>
</body>
</html>
<!--FFILE-->
<!--HFILE:vUart.html--> 
<!DOCTYPE HTML>
<html>
  <head>
    <title>SmartBMS WiFi</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
      body{min-width:310px;max-width:1000px;height:400px;margin:0 auto;font-family:"Lato",sans-serif}
      h2{font-family:Arial;font-size:2.5rem;text-align:center}
      .tablink{background:#e0e0e0;color:#333;float:left;border:none;border-radius:10px;cursor:pointer;padding:6px 12px;font-size:11px;font-weight:600;width:20%;margin:3px 0;text-align:center;transition:background .25s,transform .25s,box-shadow .25s;box-shadow:0 1px 2px rgba(0,0,0,.08);}
      .tablink:hover{background:#d5d5d5;transform:translateY(-2px);box-shadow:0 2px 4px rgba(0,0,0,.12);}
      .tablink.active{background:#00978f;color:#fff;transform:translateY(-2px);box-shadow:0 2px 4px rgba(0,0,0,.15);}
      .tabcontent{color:#000;display:none;padding:20px;text-align:center}
      .btn-group button{background:#04AA6D;border:1px solid green;border-radius:12px;margin:4px 2px;color:#fff;padding:10px 24px;cursor:pointer;float:left}
      .btn-group:after{content:"";clear:both;display:table}
      .btn-group button:not(:last-child){border-right:none}
      .btn-group button:hover{background:#3e8e41}
      #unLicensed{color:red;background:transparent;text-decoration:none}
      .led{display:inline-block;width:12px;height:12px;border-radius:50%%;margin-left:6px;background:#900}
      .led.on{background:#0c0}
    </style>
  </head>

  <script>
    function submitMessage(){setTimeout(()=>{document.location.reload(false)},2000)}
    function openTab(color){
      let t=document.getElementsByClassName("tabcontent")
      for(let i=0;i<t.length;i++)t[i].style.display="none"
      let l=document.getElementsByClassName("tablink")
      for(let i=0;i<l.length;i++)l[i].style.backgroundColor=""
      let box=document.getElementById("defaultOpen").textContent
      document.getElementById(box).style.display="block"
      document.getElementById("defaultOpen").style.backgroundColor=color
    }
  </script>

  <body>
    <button class="tablink" onclick="window.location.href='/'">Status</button>
    <button class="tablink" onclick="window.location.href='/batt'">Battery</button>
    <button class="tablink" onclick="window.location.href='/graph'">Monitor</button>
    <button class="tablink" onclick="window.location.href='/config'" id="defaultOpen">Settings</button>
    <button class="tablink" onclick="window.location.href='/fwupgrade'">Upgrade</button>

    <div id="Settings" class="tabcontent"></div>

    <div style="margin:15px">
      <br><center><b>VIRTUAL UART CONFIG</b></center><br>
      <center><span id="fMem"></span></center>
      <center><font id="fwStat"></font></center><br>
      <hr><br>

      <!-- FORM COMPLETO -->
      <form action="/getmisc" target="hidden-form">
        <span title="Enable UART Tunnel (eg for PCMaster or JK-BMS-MONITOR)">UART Tunnel:
          <input type="checkBox" name="tcpVConsole" id="vUrt" onclick="wsSendUart()">
        </span><br><br>

        Virtual UART Mode:
        <select id="vMode"
                onfocus="editing.vMode = true"
                onblur="wsSendMode()">
          <option value="0">SERVER</option>
          <option value="1">CLIENT</option>
        </select><br><br>

        <!-- IP/HOSTNAME -->
        <div id="vIPbox" style="display:none;margin-top:10px">
          Remote Server IP/Host:
          <input type="text" id="vIP" value=""
                 style="width:180px"
                 onfocus="editing.vIP = true"
                 onblur="wsSendIP()">
          <span id="vIPerr" style="color:red;display:none">Invalid IP/Hostname</span>
        </div>
        <br>

        Uart Tunnel Port:
        <input type="number" id="vPort" min="1" max="65535" value="6790"
               style="width:70px"
               onfocus="editing.vPort = true"
               onblur="wsSendPort()"><br><br>

        No Timeout on WS:
        <input type="checkbox" id="vInf" onclick="wsSendInf()"><br><br>
      </form>

      <div id="uartStats" style="display:none;margin-top:10px;text-align:left">
        <b>Virtual UART Status</b><br>
        Remote Connected: <span id="uartConnLED" class="led" title="Not connected"></span><br>
        RX bytes: <span id="uartRX">0</span><br>
        TX bytes: <span id="uartTX">0</span><br>
        Uptime UART: <span id="uartUP">0s</span><br>
        Timeout WS: <span id="uartTO">0s</span><br>
      </div>

      <hr><br>
      <div class="btn-group"><button onclick="window.location.href='config'">BACK to CONFIG</button></div>
      <iframe style="display:none" name="hidden-form"></iframe>
    </div>

    <script>
      let ws=null,hbTimer=null,uartStart=0,uartUptimeTimer=null,lastConnState=0

      /* PATCH: LOCK EDITING */
      let editing = {
        vIP: false,
        vPort: false,
        vMode: false
      };

      function wsFailReload(){setTimeout(()=>location.reload(),2000)}

      function updateUptime(){
        if(!uartStart)return
        let sec=Math.floor((Date.now()-uartStart)/1000)
        document.getElementById("uartUP").textContent=sec+"s"
      }

      function formatBytes(bytes){
        if(bytes===0)return"0 B"
        const units=["B","KB","MB","GB","TB"],k=1024
        const i=Math.floor(Math.log(bytes)/Math.log(k))
        const value=bytes/Math.pow(k,i)
        const fixed=(value<10)?value.toFixed(1):Math.round(value)
        return fixed+" "+units[i]
      }

      function isValidIP(ip){
        const parts = ip.split(".");
        if(parts.length !== 4) return false;
        return parts.every(p => /^\d+$/.test(p) && p >= 0 && p <= 255);
      }

      function isValidHostname(h){
        return /^[a-zA-Z0-9.-]{1,253}$/.test(h);
      }

      function validateIP(){
        let v = document.getElementById("vIP").value.trim();
        let err = document.getElementById("vIPerr");

        if (isValidIP(v) || isValidHostname(v)) {
          err.style.display = "none";
          return true;
        }

        err.style.display = "inline";
        return false;
      }

      function updateView() {
        const v = document.getElementById("vUrt").checked;
        ["vPort","vIP","vMode"].forEach(id => 
          document.getElementById(id).disabled = v
        );
        document.getElementById("uartStats").style.display = v ? "block" : "none";
      }

      /* WS SEND */
      function wsSendUart(){
        if(!ws||ws.readyState!==1)return
        let v=document.getElementById("vUrt").checked?1:0
        ws.send(JSON.stringify({vUrt:v}))
        updateView();
      }

      function wsSendPort(){
        if(!ws||ws.readyState!==1)return
        let p=parseInt(document.getElementById("vPort").value)
        ws.send(JSON.stringify({vPrt:p}))
        editing.vPort = false;
      }

      function wsSendInf(){
        if(!ws||ws.readyState!==1)return
        let inf=document.getElementById("vInf").checked?1:0
        ws.send(JSON.stringify({vInf:inf}))
      }

      function wsSendMode(){
        let mode = parseInt(document.getElementById("vMode").value);
        document.getElementById("vIPbox").style.display = (mode === 1) ? "block" : "none";
        if(!ws||ws.readyState!==1)return
        ws.send(JSON.stringify({vSC:mode}))
        editing.vMode = false;
      }

      function wsSendIP(){
        if(!validateIP()) return
        if(!ws||ws.readyState!==1)return
        let ip = document.getElementById("vIP").value.trim()
        ws.send(JSON.stringify({vIP:ip}))
        editing.vIP = false;
      }

      /* WS RECEIVE */
      function startWS(){
        var gateway=`ws://${window.location.hostname}:${window.location.port}/ws`
        ws=new WebSocket(gateway)
        let openTimeout=setTimeout(()=>{wsFailReload()},2000)

        ws.onopen=()=>{clearTimeout(openTimeout)}
        ws.onerror=()=>wsFailReload()
        ws.onclose=()=>wsFailReload()

        ws.onmessage=(e)=>{
          console.log("WS RAW:",e.data)
          let d;try{d=JSON.parse(e.data)}catch(e){return}

          if(d.vUrt !== undefined ){
            document.getElementById("vUrt").checked=(d.vUrt===1);
            updateView();
          }else{
            document.getElementById("uartStats").style.display="none";
            return;
          }

          document.getElementById("fMem").textContent=d.heap+" Bytes"
          


          if (d.lic !== undefined ) {
            let licMsg = "<br><a id='unLicensed' href='license.html'><b>ACTIVATE</b></a><br>";
            document.getElementById("fwStat").innerHTML = (d.lic === 0) ? licMsg : "";
          }

          /* MODE */
          if (d.vSC !== undefined && !editing.vMode) {
            let mode = parseInt(d.vSC);
            document.getElementById("vMode").value = mode;
            document.getElementById("vIPbox").style.display = (mode === 1) ? "block" : "none";
          }

          /* IP/HOSTNAME */
          if (d.vIP !== undefined && !editing.vIP) {
            document.getElementById("vIP").value = d.vIP;
            validateIP();
          }

          /* PORT */
          if (d.vPrt !== undefined && !editing.vPort) {
            document.getElementById("vPort").value = d.vPrt;
          }


          // document.getElementById("vPort").disabled=true;
          // document.getElementById("uartStats").style.display="block";

          let led=document.getElementById("uartConnLED")
          if(d.vCnt){
            led.classList.add("on")
            led.title="Connected"
            if(lastConnState===0){
              uartStart=Date.now()
              clearInterval(uartUptimeTimer)
              uartUptimeTimer=setInterval(updateUptime,1000)
            }
            lastConnState=1
          }else{
            led.classList.remove("on")
            led.title="Not connected"
            lastConnState=0
            uartStart=0
            clearInterval(uartUptimeTimer)
            document.getElementById("uartUP").textContent="0s"
          }

          document.getElementById("uartRX").textContent=formatBytes(d.vRxB)
          document.getElementById("uartTX").textContent=formatBytes(d.vTxB)
          document.getElementById("vInf").checked=d.vInf;
          if (d.vTmt != 0xFFFF) document.getElementById("uartTO").textContent=d.vTmt+"s"; else document.getElementById("uartTO").textContent="oo";
        }
      }

      hbTimer=setInterval(()=>{if(ws&&ws.readyState===1)ws.send(JSON.stringify({uGet:1}))},1000)
      document.addEventListener("DOMContentLoaded",startWS)
      openTab('red')

    </script>
  </body>
</html>
<!--FFILE-->
