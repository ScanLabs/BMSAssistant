<!DOCTYPE HTML><html>
<head>
  <title>SmartBMS WiFi</title>    
  <style>
body {
 min-width: 310px;
 max-width: 1000px;
 height: 400px;
 margin: 0 auto;
 font-family: "Lato", sans-serif;
}
h2 {
 font-family: Arial;
 font-size: 2.5rem;
 text-align: center;
}
.tablink {
  background-color: #555;
  color: white;
  float: left;
  border: none;
  border-radius: 10px;
  outline: none;
  cursor: pointer;
  padding: 8px 12px;
  font-size: 13px;
  width: 20%% ;
}
.tablink:hover {
  background-color: #777;
}
.tabcontent {
  color: black;
  display: none;
  padding: 20px;
  text-align: center;
}
.btn-group button {
  background-color: #04AA6D; 
  border: 1px solid green; 
  border-radius: 12px;
  margin: 4px 2px;
  color: white; 
  padding: 10px 24px; 
  cursor: pointer; 
  float: left; 
}
.btn-group:after {
  content: "";
  clear: both;
  display: table;
}
.btn-group button:not(:last-child) {
  border-right: none; 
}
.btn-group button:hover {
  background-color: #3e8e41;
}
</style> 
  <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<script>
function openTab(color){
  var i,tabcontent,tablinks,boxName;
  tabcontent=document.getElementsByClassName("tabcontent");
  for (i=0; i < tabcontent.length; i++){
    tabcontent[i].style.display="none";
  }
  tablinks=document.getElementsByClassName("tablink");
  for (i=0; i < tablinks.length; i++){
    tablinks[i].style.backgroundColor="";
  }
  boxName = document.getElementById("defaultOpen").textContent;
  document.getElementById(boxName).style.display="block";
  document.getElementById("defaultOpen").style.backgroundColor=color;
}
</script>
<body>
  <button class="tablink" onclick="window.location.href='/';">Status</button> 
  <button class="tablink" onclick="window.location.href='/batt';">Battery</button>
  <button class="tablink" onclick="window.location.href='/graph';">Monitor</button>
  <button class="tablink" onclick="window.location.href='/config';" id="defaultOpen">Settings</button>
  <button class="tablink" onclick="window.location.href='/fwupgrade';">Upgrade</button>
  <div id="Settings" class="tabcontent"></div>
  <div style='margin:15px;'><br><center><b>BMS FAILURES CODE</center></b><br><br><hr><br>
  <div id='failureCodes'></div><br><br>
  <div class="btn-group">
    <button onclick="window.location.href='/';">BACK to HOME</button>
  </div>  
<script>
  var theFailureStatus = document.getElementById('failureCodes');
  const FArr = [%bmsFailuresString%];
  const bmsType = %bmsKind%;
  const protocolType = %prtType%;
  const Alarms = %bmsFailBool%;
  openTab('red');
  let FStr = "Model: ";
  if ( bmsType == 0){ 
    FStr += "DALY-BMS<br>Protocol: ";
  if (protocolType == 0) FStr += "Former";
  if (protocolType == 1) FStr += "New";
  FStr +="<br>Alarms: ";
  if (Alarms) FStr += "<br>"; else FStr += "NONE<br>";
  if ( FArr[0] & 1<<0 ) FStr += "Cell high V L1";
  if ( FArr[0] & 1<<1 ) FStr += "Cell high V L2";
  if ( FArr[0] & 1<<2 ) FStr += "Cell low V L1";
  if ( FArr[0] & 1<<3 ) FStr += "Cell low V L2";
  if ( FArr[0] & 1<<4 ) FStr += "Sum high V L1";
  if ( FArr[0] & 1<<5 ) FStr += "Sum high V L1";
  if ( FArr[0] & 1<<6 ) FStr += "Sum low V L1";
  if ( FArr[0] & 1<<7 ) FStr += "Sum low V L2";
  if ( FArr[1] & 1<<0 ) FStr += "Chg high T L1";
  if ( FArr[1] & 1<<1 ) FStr += "Chg high T L2";
  if ( FArr[1] & 1<<2 ) FStr += "Chg low T L1";
  if ( FArr[1] & 1<<3 ) FStr += "Chg low T L2";
  if ( FArr[1] & 1<<4 ) FStr += "Dischg high T L1";
  if ( FArr[1] & 1<<5 ) FStr += "Dischg high T L2";
  if ( FArr[1] & 1<<6 ) FStr += "Dischg low T L1";
  if ( FArr[1] & 1<<7 ) FStr += "Dischg low T L2";
  if ( FArr[2] & 1<<0 ) FStr += "Chg overcurr. L1";
  if ( FArr[2] & 1<<1 ) FStr += "Chg overcurr. L2";
  if ( FArr[2] & 1<<2 ) FStr += "Dischg overcurr. L1";
  if ( FArr[2] & 1<<3 ) FStr += "Dischg overcurr. L2";
  if ( FArr[2] & 1<<4 ) FStr += "SOC high L1";
  if ( FArr[2] & 1<<5 ) FStr += "SOC high L2";
  if ( FArr[2] & 1<<6 ) FStr += "SOC Low L1";
  if ( FArr[2] & 1<<7 ) FStr += "SOC Low L2";
  if ( FArr[3] & 1<<0 ) FStr += "Diff volt L1";
  if ( FArr[3] & 1<<1 ) FStr += "Diff volt L2";
  if ( FArr[3] & 1<<2 ) FStr += "Diff temp L1";
  if ( FArr[3] & 1<<3 ) FStr += "Diff temp L2";
  if ( FArr[4] & 1<<0 ) FStr += "Chg MOS high T";
  if ( FArr[4] & 1<<1 ) FStr += "Dischg MOS high T ";
  if ( FArr[4] & 1<<2 ) FStr += "Chg MOS T sensor err";
  if ( FArr[4] & 1<<3 ) FStr += "Dischg MOS T sensor err";
  if ( FArr[4] & 1<<4 ) FStr += "Chg MOS adhesion err";
  if ( FArr[4] & 1<<5 ) FStr += "Dischg MOS adhesion err";
  if ( FArr[4] & 1<<6 ) FStr += "Chg MOS open circuit err";
  if ( FArr[4] & 1<<7 ) FStr += "Discrg MOS open circuit err";
  if ( FArr[5] & 1<<0 ) FStr += "AFE collect chip err";
  if ( FArr[5] & 1<<1 ) FStr += "Voltage collect dropped";
  if ( FArr[5] & 1<<2 ) FStr += "Cell T sensor err";
  if ( FArr[5] & 1<<3 ) FStr += "EEPROM err";
  if ( FArr[5] & 1<<4 ) FStr += "RTC err";
  if ( FArr[5] & 1<<5 ) FStr += "Precharge failure";
  if ( FArr[5] & 1<<6 ) FStr += "Comm. failure";
  if ( FArr[5] & 1<<7 ) FStr += "Internal comm. failure";
  if ( FArr[6] & 1<<0 ) FStr += "Current module fault";
  if ( FArr[6] & 1<<1 ) FStr += "Sum voltage detect fault";
  if ( FArr[6] & 1<<2 ) FStr += "Short circuit protect fault";
  if ( FArr[6] & 1<<3 ) FStr += "Low volt forbidden chg fault";
}
if ( bmsType == 1){
  FStr += "JK-BMS<br>Protocol: ";
  if (protocolType == 0) FStr += "000-4G-GPS";
  if (protocolType == 1) FStr += "001-RS485 Modbus v1.0";
  if (protocolType == 2) FStr += "000-CAN Protocol (250K) V2.0";
  FStr +="<br>Alarms: ";
  if (Alarms) FStr += "<br>"; else FStr += "NONE<br>";
  if ( protocolType ==0 ){
    if ( FArr[0] & 1<<0 ) FStr += "Sensor2 Overtemperature";
    if ( FArr[0] & 1<<1 ) FStr += "Sensor1 or2 low temperature";
    if ( FArr[0] & 1<<2 ) FStr += "Cell Overvoltage";
    if ( FArr[0] & 1<<3 ) FStr += "Cell Undervoltage";
    if ( FArr[0] & 1<<4 ) FStr += "309_A protection";
    if ( FArr[0] & 1<<5 ) FStr += "309_B protection";
    if ( FArr[1] & 1<<0 ) FStr += "Low capacity";
    if ( FArr[1] & 1<<1 ) FStr += "Power MosFet overtemperature";
    if ( FArr[1] & 1<<2 ) FStr += "Overvoltage";
    if ( FArr[1] & 1<<3 ) FStr += "Discharging Undervoltage";
    if ( FArr[1] & 1<<4 ) FStr += "Sensor1_2 Overtemperature";
    if ( FArr[1] & 1<<5 ) FStr += "Charging Overcurrent";
    if ( FArr[1] & 1<<6 ) FStr += "Discharging Overcurrent";
    if ( FArr[1] & 1<<7 ) FStr += "Cell voltage difference";
  }
  if ( protocolType ==1){
    if (FArr[0] & (1<<0)) FStr += "AlarmWireRes";
    if (FArr[0] & (1<<1)) FStr += "AlarmMosOTP";
    if (FArr[0] & (1<<2)) FStr += "AlarmCellQuantity";
    if (FArr[0] & (1<<3)) FStr += "AlarmCurSensorErr";
    if (FArr[0] & (1<<4)) FStr += "AlarmCellOVP";
    if (FArr[0] & (1<<5)) FStr += "AlarmBatOVP";
    if (FArr[0] & (1<<6)) FStr += "AlarmChOCP";
    if (FArr[0] & (1<<7)) FStr += "AlarmChSCP";
    if (FArr[1] & (1<<0)) FStr += "AlarmChOTP";
    if (FArr[1] & (1<<1)) FStr += "AlarmChUTP";
    if (FArr[1] & (1<<2)) FStr += "AlarmCPUAuxCommuErr";
    if (FArr[1] & (1<<3)) FStr += "AlarmCellUVP";
    if (FArr[1] & (1<<4)) FStr += "AlarmBatUVP";
    if (FArr[1] & (1<<5)) FStr += "AlarmDchOCP";
    if (FArr[1] & (1<<6)) FStr += "AlarmDchSCP";
    if (FArr[1] & (1<<7)) FStr += "AlarmDchOTP";
    if (FArr[2] & (1<<0)) FStr += "AlarmChargeMOS";
    if (FArr[2] & (1<<1)) FStr += "AlarmDischargeMOS";
    if (FArr[2] & (1<<2)) FStr += "GPSDisconneted";
    if (FArr[2] & (1<<3)) FStr += "ModifyPWDinTime";
    if (FArr[2] & (1<<4)) FStr += "DischargeOnFailed";
    if (FArr[2] & (1<<5)) FStr += "BatteryOverTemp";
    if (FArr[2] & (1<<6)) FStr += "TemperatureSensorAnomaly";
    if (FArr[2] & (1<<7)) FStr += "PLCModuleAnomaly";
  }
  if (protocolType == 2) {
    if (FArr[0] & (1<<0)) FStr += "Line resistance too high<br>";
    if (FArr[0] & (1<<1)) FStr += "MOS over-temperature<br>";
    if (FArr[0] & (1<<2)) FStr += "Cell count mismatch<br>";
    if (FArr[0] & (1<<3)) FStr += "Current sensor abnormal<br>";
    if (FArr[0] & (1<<4)) FStr += "Cell over-voltage<br>";
    if (FArr[0] & (1<<5)) FStr += "Pack over-voltage<br>";
    if (FArr[0] & (1<<6)) FStr += "Charge over-current<br>";
    if (FArr[0] & (1<<7)) FStr += "Charge short-circuit<br>";
    if (FArr[1] & (1<<0)) FStr += "Charge temperature too high<br>";
    if (FArr[1] & (1<<1)) FStr += "Charge temperature too low<br>";
    if (FArr[1] & (1<<2)) FStr += "Internal communication fault<br>";
    if (FArr[1] & (1<<3)) FStr += "Cell under-voltage<br>";
    if (FArr[1] & (1<<4)) FStr += "Pack under-voltage<br>";
    if (FArr[1] & (1<<5)) FStr += "Discharge over-current<br>";
    if (FArr[1] & (1<<6)) FStr += "Discharge short-circuit<br>";
    if (FArr[1] & (1<<7)) FStr += "Discharge temperature too high<br>";
    if (FArr[2] & (1<<0)) FStr += "Charge MOS fault<br>";
    if (FArr[2] & (1<<1)) FStr += "Discharge MOS fault<br>";
  }
}
 theFailureStatus.insertAdjacentHTML( 'beforeend', FStr );
 </script>
</body></html>

<!--FFILE-->
<!--HFILE:gauge-rep-jk.html--> 
<html>
<head>
<title>ScanLabs SMART BMS DATA EXTRACTOR</title>
<meta name="viewport"content="width=device-width,initial-scale=1">  
<style>
body{max-width:1000px;margin:0 auto;font-family:Lato,sans-serif}
.tablink{background:#e0e0e0;color:#333;float:left;border:none;border-radius:10px;cursor:pointer;padding:6px 12px;font-size:11px;font-weight:600;width:20%%;margin:3px 0;text-align:center;transition:background .25s,transform .25s,box-shadow .25s;box-shadow:0 1px 2px rgba(0,0,0,.08);}
.tablink:hover{background:#d5d5d5;transform:translateY(-2px);box-shadow:0 2px 4px rgba(0,0,0,.12);}
.tablink.active{background:#00978f;color:#fff;transform:translateY(-2px);box-shadow:0 2px 4px rgba(0,0,0,.15);}
.tabcontent{color:#000;display:none;padding:20px;text-align:center}
a:link{color:blue;background:0 0;text-decoration:none}
.blink{animation:blinker 2s linear infinite;color:red;font-size:1em;margin-bottom:20px}
@keyframes blinker{50%%{opacity:0}}
table,th,td{color:#fff;font-weight:400;border:0}
table{border-collapse:collapse}
tr{border:0}
th1{padding:10px;font-size:14px;display:inline-block;text-decoration:none;border-right:1px solid #41cd52;color:#fff}
.center{margin:0 auto;width:100%%;border:0}
.buttonR{background:#144964;border:0;color:#fff;padding:3px;text-align:center;text-decoration:none;display:inline-block;font-size:16px;margin:4px 2px;cursor:pointer;border-radius:40%%}
.w45{width:45%%}
.w10{width:10%%}
.w38{width:38%%}
.w24{width:24%%}
.w220{width:220px}
.w160{width:160px}
.txr{text-align:right}
.txl{text-align:left}
.txc{text-align:center}
.c41{color:#41cd52}
.fs14{font-size:14px}
.font0{color:#fffffe;font-size:12px;font-weight:400}
.font1{color:#41cd52;font-size:35px;font-weight:700}
.font2{color:#41cd52;font-size:17px;font-weight:700;vertical-align:top}
.font4{font-size:16px;text-align:center;font-weight:400;vertical-align:text-bottom}
.font5{color:#41cd52;font-size:8px;text-align:left;font-weight:400;vertical-align:top}
@media (min-width: 900px) { .font0 { font-size: calc(12px * 1.30); } .fs14 { font-size: calc(14px * 1.20); } .font4 { font-size: calc(16px * 1.20); } .font5 { font-size: calc(8px * 1.20); }}
</style>
</head>
<script src="%GAUGE_SOURCE%"></script>
<body style="background-color:#1f1e22"onload="setSOC()">
<button class="tablink"onclick="closeSocket();window.location.href=window.location.href;"id="defaultOpen"">Status</button> 
<button class="tablink"onclick="closeSocket();window.location.href=window.location.href + 'batt';">Battery</button>
<button class="tablink"onclick="closeSocket();window.location.href=window.location.href + 'graph';">Monitor</button>
<button class="tablink"onclick="closeSocket();window.location.href=window.location.href + 'config';">Settings</button>
<button class="tablink"onclick="closeSocket();window.location.href=window.location.href + 'fwupgrade';">Upgrade</button>
<div id="Status"class="tabcontent">
<table style="width:100%%">
  <tr>
    <th1><span class="font0">Charge:&nbsp<b><a id="CHM"href="#"class="nounderline"onclick="SwitchChargeMOS();return false;"></a></b></span></th1>
    <th1><span class="font0">Discharge:&nbsp<b><a id="SDM"href="#"class="nounderline"onclick="SwitchDisChargeMOS();return false;"></a></b></span></th1>
    <th1><span class="font0">Balance:&nbsp<b><a id="BLS"href="#"class="nounderline"onclick="SwitchBalanceMOS();return false;"></a></b></span></th1>
    <th1 style="border-right:0"><span class="font0">Alarm:&nbsp<b><a id="alarmStat" href="bmsalarms" class="nounderline"></a></b></span></th1>
  </tr>
</table>
<span class="font0" id="wbsts"></span>
<br><span class="font0"><b><span class="font0" id="ctm"></span></b><span class="font0" id="geo"></span></span>
<table class="center">
  <tr>
    <td class="w45"></td>
    <td class="w10"><canvas id="SOC"></canvas></td>
    <td class="w45"></td>
  </tr>
</table>
<table class="center">
  <tr>
    <td class="w38 txr">
      <span class="font1" id="vol"></span><span class="font2">V</span>
    </td>
    <td class="w24 txc">
      <span class="font4" id="dnm"></span>
    </td>
    <td class="w38 txl">
      <span class="font1" id="cur"></span><span class="font2">A</span>
    </td>
  </tr>
</table>
<br>
<table class="center">
  <tr>
    <td class="w220 txr fs14">Battery Pow.:</td>
    <td class="w160 txl fs14 c41">&nbsp;<span id="wat"></span><span class="font5">&nbsp;W</span></td>
    <td class="w220 txr fs14">Ave.Cell Volt:</td>
    <td class="w160 txl fs14 c41">&nbsp;<span id="vav"></span><span class="font5">&nbsp;V</span></td>
  </tr>
  <tr>
    <td class="txr fs14">Battery Cap.:</td>
    <td class="txl fs14 c41">&nbsp;<span id="bcp"></span><span class="font5">&nbsp;Ah</span></td>
    <td class="txr fs14">Cell Volt. Diff.:</td>
    <td class="txl fs14 c41">&nbsp;<span id="vdl"></span><span class="font5">&nbsp;mV</span></td>
  </tr>
  <tr>
    <td class="txr fs14">Remain Cap.:</td>
    <td class="txl fs14 c41">&nbsp;<span id="rcp"></span><span class="font5">&nbsp;Ah</span></td>
    <td class="txr fs14">Balance Curr.:</td>
    <td class="txl fs14 c41">&nbsp;<span id="blc"></span><span class="font5">&nbsp;mA</span></td>
  </tr>
  <tr>
    <td class="txr fs14">Remain Batt.:</td>
    <td class="txl fs14 c41">&nbsp;<span id="soc"></span><span class="font5">&nbsp;%%</span></td>
    <td class="txr fs14">MOS Temp.:</td>
    <td class="txl fs14 c41">&nbsp;<span id="mtm"></span><span class="font5">&nbsp;&#8451;</span></td>
  </tr>
  <tr>
    <td class="txr fs14">Cycle Count:</td>
    <td class="txl fs14 c41">&nbsp;<span id="cyc"></span></td>
    <td class="txr fs14">Battery T1:</td>
    <td class="txl fs14 c41">&nbsp;<span id="bt1"></span><span class="font5">&nbsp;&#8451;</span></td>
  </tr>
  <tr>
    <td class="txr fs14">Cycle Cap.:</td>
    <td class="txl fs14 c41">&nbsp;<span id="ccy"></span><span class="font5">&nbsp;Ah</span></td>
    <td class="txr fs14">Battery T2:</td>
    <td class="txl fs14 c41">&nbsp;<span id="bt2"></span><span class="font5">&nbsp;&#8451;</span></td>
  </tr>
  <tr>
    <td class="txr fs14">Battery T4:</td>
    <td class="txl fs14 c41">&nbsp;<span id="bt4"></span><span class="font5">&nbsp;&#8451;</span></td>
    <td class="txr fs14">Battery T5:</td>
    <td class="txl fs14 c41">&nbsp;<span id="bt5"></span><span class="font5">&nbsp;&#8451;</span></td>
  </tr>
  <tr>
    <td class="txr fs14">Heartbeat:</td>
    <td class="txl fs14 c41">&nbsp;<span id="hbt"></span></td>
    <td class="txr fs14">Max Battery:</td>
    <td class="txl fs14 c41">
      &nbsp;<span id="msc"></span>
      <span class="font5">%% <span id="mst"></span></span>
    </td>
  </tr>
</table>
<p id="allBatts"></p><p id="allRes"></p>
<br><a href="releasenote.html"class="nounderline"style="color:#fffffe">FW Version:<b>&nbsp<span id="fwv"></span></a></b>
<span class="fs14" id="fwAvail"></span>
<span class="fs14" id="fwStat"></span>
<br><span class="fs14" style="color:#fffffe"><span id="val"></span></span>
</div>
<script>
var tID=0;
var gateway=`ws://${window.location.hostname}:${window.location.port}/ws`;
var websocket,IntervalId;
var disChargeFetState=0,chargeFetState=0,packWatts=0,fwStatus=1,newFWAvl=0,enMOS=0,wMode=1,fal=0,cellN=0;
var Clayout=255;
var onOpenTO=1500;
var battsNow=[];
var resNow=[]; 
var optsJK={
    angle:0,
    lineWidth:0.15,
    radiusScale:0.80,
    pointer:{
      length:0.50,
      strokeWidth:0.04,
      color:'#41cd52'  
    },
    limitMax:false,    
    limitMin:false,    
    generateGradient:true,
    highDpiSupport:true,    
    percentColors:[[0.0,"#e30e0e"],
    [0.5,"#e3dc0e"],
    [0.8,"#cae30e"],
    [1.0,"#0ee331"]
    ],   
  staticLabels:{
    font:"15px sans-serif", 
    labels:[0,25,50,75,100], 
    color:"#41cd52", 
    fractionDigits:0  
  },
};
window.addEventListener("beforeunload", function () {
    if (websocket && websocket.readyState === WebSocket.OPEN) {
        //websocket.send("wclose");
        websocket.close(3001, "page closing");
    }
});
let SwitchAlertMsg="Feauture disabled - enable it on Settings->MISC page";
function closeSocket(){
  clearInterval(IntervalId);
  websocket.close(3001,"force");
}
function onload(event){ 
  setTimeout(function(){initWebSocket();},1000);
  document.getElementById("wbsts").innerHTML="<br><span class=\"blink\"><b>Open Stream ...</b></span><br>";
}
function startSequence(){tID=0;websocket.send("getBMSData 0");}
function initWebSocket(){
    //console.log('WebSocket Init...');
    websocket=new WebSocket(gateway);
    websocket.onopen=onOpen;
    websocket.onclose=onClose;
    websocket.onmessage=onMessage;
    websocket.onerror=onError;
}
function onError(event){
    //console.log('WebSocket Error');
    clearInterval(IntervalId);
    setTimeout(function(){window.location.reload();},2000);
}
function onOpen(event){
    //console.log('WebSocket Open');
    startSequence();
    IntervalId = setInterval(startSequence, 2000);
}
function onClose(event){
    //console.log('WebSocket Closed');
    clearInterval(IntervalId);
    if (event.code !=3001)
        setTimeout(function(){window.location.reload();},3000);
}
function onMessage(event){
    console.log(event.data);
    var myObj=JSON.parse(event.data);
    var keys;
    if (myObj) keys=Object.keys(myObj); else return;
    for (var i=0; i < keys.length; i++){
        var key=keys[i];
        switch (key){
            case 'soc':var tmpSOC=myObj[key];document.getElementById(key).innerHTML=tmpSOC;setSOC(tmpSOC);break;
            case 'dfs':disChargeFetState=myObj[key];set_SWITCH_MosStatus(0);break;             
            case 'cfs':chargeFetState=myObj[key];set_SWITCH_MosStatus(1);break;
            case 'bls':balanceFetState=myObj[key];set_SWITCH_MosStatus(2);break;             
            case 'lic':fwStatus=myObj[key];break;
            case 'nfa':newFWAvl=myObj[key];break; 
            case 'ems':enMOS=myObj[key];break;
            case 'wat':packWatts=myObj[key];break;
            case 'wmd':wMode=myObj[key];break;            
            case 'fal':fal=myObj[key];break;
            case 'cel':cellN=myObj[key];break;
            case 'lay':Clayout=myObj[key];break;
            case 'lst':tID=myObj[key];break;
            case 'bat':battsNow=myObj[key];break;
            case 'res':resNow=myObj[key];break;
            default:const element=document.getElementById(key);if (element) element.innerHTML=myObj[key];break;
        }
    }
    if (tID == 255) {updRTdata();} else {websocket.send("getBMSData " + tID);}
}
function openTab(color){
  var i,tabcontent,tablinks,boxName;
  tabcontent=document.getElementsByClassName("tabcontent");
  for (i=0; i < tabcontent.length; i++){
    tabcontent[i].style.display="none";
  }
  tablinks=document.getElementsByClassName("tablink");
  for (i=0; i < tablinks.length; i++){
    tablinks[i].style.backgroundColor="";
  }
  boxName = document.getElementById("defaultOpen").textContent;
  document.getElementById(boxName).style.display="block";
  document.getElementById("defaultOpen").style.backgroundColor=color;
}
function SwitchDisChargeMOS(){
  var urltocall="/SwMOS?switch=dis"+ "&set="+ !disChargeFetState ;
  var msg=disChargeFetState?"OFF":"ON";
  if (!enMOS){alert(SwitchAlertMsg);return;}
  xmlhttp=new XMLHttpRequest();
  if (confirm("Switch "+ msg  + " DISCHARGE MOS ?")==true){
    xmlhttp.open("GET",urltocall,false);
    xmlhttp.send();
    disChargeFetState=!disChargeFetState;
    set_SWITCH_MosStatus(0);
    websocket.close();
  }
}
function SwitchChargeMOS(){
  var urltocall="/SwMOS?switch=crg"+ "&set="+ !chargeFetState ;
  var msg=chargeFetState?"OFF":"ON";
  if (!enMOS){alert(SwitchAlertMsg);return;}
  xmlhttp=new XMLHttpRequest();
  if (confirm("Switch "+ msg + " CHARGE MOS ?")==true){
    xmlhttp.open("GET",urltocall,false);
    xmlhttp.send();
    chargeFetState=!chargeFetState;
    set_SWITCH_MosStatus(1);
    websocket.close();
  }
}
function SwitchBalanceMOS(){
  var urltocall="/SwMOS?switch=bal"+ "&set="+ !balanceFetState ;
  var msg=balanceFetState?"OFF":"ON";
  if (!enMOS){alert(SwitchAlertMsg);return;}
  xmlhttp=new XMLHttpRequest();
  if (confirm("Switch "+ msg + " BALANCE MOS ?")==true){
    xmlhttp.open("GET",urltocall,false);
    xmlhttp.send();
    chargeFetState=!chargeFetState;
    set_SWITCH_MosStatus(2);
    websocket.close();
  }
}
function setSOC(theSoc){
  var target=document.getElementById('SOC'); 
  var gauge=new Gauge(target).setOptions(optsJK);   
  gauge.maxValue=100; 
  gauge.setMinValue(0);  
  gauge.animationSpeed=1; 
  gauge.set(theSoc); 
}
function set_SWITCH_MosStatus(ch_dsch){
  var theSwitchMOSStatus,theSwitchCurrStatus,objID;
  switch (ch_dsch) {
    case 0:objID="SDM";theSwitchCurrStatus=disChargeFetState;break;
    case 1:objID="CHM";theSwitchCurrStatus=chargeFetState;break;
    case 2:objID="BLS";theSwitchCurrStatus=balanceFetState;break;
    default:return;break;
  }
  var DSMText="<span class=\"fs14\" style=\"color:";
  if (theSwitchCurrStatus)
    DSMText +="green;\">ON"; 
  else
    DSMText +="red;\">OFF";
  DSMText +="</span>";
  document.getElementById(objID).innerHTML=DSMText;
}  
function updRTdata(){
    var element;
    tID=0;
    document.getElementById("wbsts").innerHTML="";
    document.getElementById("wat").innerHTML=packWatts;
    if (!fwStatus)
      document.getElementById("fwStat").innerHTML="<br><a id=\"unLicensed\"href=\"license.html\"><span class=\"blink\"><b>ACTIVATE SW</b></span></a>";
    else
      document.getElementById("fwStat").innerHTML="";
    if (newFWAvl)
      document.getElementById("fwAvail").innerHTML="<br><a href=\"https://www.dalybmswifi.com/fwrels/\"><span class=\"blink\"><b>NEW FIRMWARE</b></span></a>";    

    populateBatts();populateRes();populateCellsNum();populateAlms();
}
function openPopup() {
    const lat = %inputLATITUDE%;
    const lon = %inputLONGITUDE%;
    const url = `solar?lat=${lat}&lon=${lon}`;
    window.open(
        url,
        "solarPopup",
        "width=1100,height=700,resizable=yes,scrollbars=yes"
    );
}
function populateGeo(){
  var geoStr="<br><span onclick=\"openPopup()\" style=\"cursor:pointer;\">SunRise <b><span id=\"sri\"></span></b> - SunSet <b><span id=\"sst\"></span></b> <span title=\"daylight difference vs yesterday\">(<span id=\"ddu\"></span>s)</span></span><br><span title=\"click to see a week forecast\"><a href=\"\" onclick=\"openWeatherWindow()\" style=\"text-decoration:none;color:#fffffe\"> Today <b><span id=\"wtd\"></span></b></b>  Frcst <b><span id=\"wtm\"></span></b></a></span>";
  if ( %geo% )
    document.getElementById("geo").innerHTML=geoStr;
  else
    document.getElementById("geo").innerHTML="<br><a href=\"/config\"><span class=\"blink\"><b>SET PLANT COORDINATES TO SYNC TIME</b></span></a>"
}
function populateCellsNum(){let NumCll = document.getElementsByName("cel"); for (let cell of NumCll) { cell.textContent = cellN;}}
function populateBatts(){
  var maxRows=Math.trunc(battsNow.length / 3)+1;
  var maxColums=battsNow.length, ckRes=0;
  var max=battsNow.reduce((iMax,x,i,arr)=> x > arr[iMax] ? i :iMax,0);
  let min=battsNow.reduce((iMax,x,i,arr)=> x < arr[iMax] ? i :iMax,0);
  let battArrayString="<p style=\"color:#96d0ff\"><b><span name=\"cel\"></span> Cells Voltage</b></p><table class=\"center\">";
  let string1="<span class=\"font5\" ", string2=">&nbsp;V</span></td>";
  let battID=0;
  if (maxColums > 2) 
    maxColums=3;
  for (row=0; row < maxRows; row++){
    battArrayString +="<tr>";
    for (cln=0; cln < maxColums ; cln++){
      if (battID < battsNow.length){
        if (battsNow[battID]) ckRes++;
        battsNow[battID]=(battsNow[battID]/1000).toFixed(3);
        battArrayString += "<td style=\"width:16%%;text-align:right\"><button class=\"buttonR\">&nbsp"+ ("0"+ (battID+1)).slice(-2) + "&nbsp</button></td>";
        battArrayString += "<td style=\"width:16%%;text-align:left;padding:10px;color:";
        if (battID==max)
          battArrayString += "red\">"+ battsNow[battID] + string1 + "style=\"color:red\"" + string2;
        else if (battID==min)
          battArrayString += "white\">"+ battsNow[battID] + string1 + "style=\"color:#fffffe\"" + string2;
        else
          battArrayString += "#41cd52\">"+ battsNow[battID] + string1 + string2;
        battID++;
      }
    }
    battArrayString +="</tr>"; 
  }
  battArrayString +="</table>"; 
  if (ckRes) document.getElementById("allBatts").innerHTML=battArrayString;  
}
function populateRes(){
  var maxRows=Math.trunc(resNow.length / 3)+1;
  var maxColums=resNow.length;
  let battArrayString="<p style=\"color:#96d0ff\"><b><span name=\"cel\"></span> Cells Wiring Resistance</b></p><table class=\"center\">";
  let battID=0, ckRes=0;
  if (maxColums > 2) 
    maxColums=3;
  for (row=0; row < maxRows; row++){
    battArrayString +="<tr>";
    for (cln=0; cln < maxColums ; cln++){
      if (battID < resNow.length){
        if (resNow[battID]) ckRes++;
        resNow[battID]=(resNow[battID]/1000).toFixed(3);
        battArrayString += "<td style=\"width:16%%;text-align:right\"><button class=\"buttonR\">&nbsp"+ ("0"+ (battID+1)).slice(-2) + "&nbsp</button></td>";
        battArrayString += "<td style=\"width:16%%;text-align:left;padding:10px;color:#41cd52;\">"+ resNow[battID] + "<span class=\"font5\">&nbsp&#8486;</span></td>";
        battID++;
      }
    }
    battArrayString +="</tr>"; 
  }
  battArrayString +="</table>"; 
  if (ckRes) document.getElementById("allRes").innerHTML=battArrayString;  
}
function populateAlms(){
  let theString="<span class=\"fs14\" style=\"color:";
  if (fal){theString +="yellow\">ON";}else{ theString+="green\">OFF";}
  theString+="</span>";
  document.getElementById("alarmStat").innerHTML=theString ;
}
function openWeatherWindow(){
    if (wMode)
      window.open("%weatherLink%","Weather","width=500,height=120");
}
window.addEventListener('load',onload());
openTab('red');
populateGeo();
</script>   
</body>
</html> 

<!--FFILE-->
<!--HFILE:gauge-rep.html--> 
<!DOCTYPE html>
<html>
<head>
  <title>ScanLabs SMART BMS DATA EXTRACTOR</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">  
  <style>
  body{max-width:1000px;margin:0 auto;font-family:"Lato",sans-serif;}
  h2{font-family:Arial;font-size:2.5rem;text-align:center;}
  .tablink{background:#e0e0e0;color:#333;float:left;border:none;border-radius:10px;cursor:pointer;padding:6px 12px;font-size:11px;font-weight:600;width:20%%;margin:3px 0;text-align:center;transition:background .25s,transform .25s,box-shadow .25s;box-shadow:0 1px 2px rgba(0,0,0,.08);}
  .tablink:hover{background:#d5d5d5;transform:translateY(-2px);box-shadow:0 2px 4px rgba(0,0,0,.12);}
  .tablink.active{background:#00978f;color:#fff;transform:translateY(-2px);box-shadow:0 2px 4px rgba(0,0,0,.15);}
  .tabcontent{color:#000;display:none;padding:20px;text-align:center}
  a:link{color:blue;background-color:transparent;text-decoration:none;}
  .blink{animation:blinker 2s linear infinite;color:red;font-size:1em;margin-bottom:20px;}
  @keyframes blinker{50%%{opacity:0;}}
  table,th,td{color:white;font-weight:normal;border:0px solid white;}
  tablef,thf,tdf{color:black;font-weight:normal;border:0px solid white;}
  table{border-collapse:collapse;}
  tr{border:none;}
  th1{padding:10px;font-size:14px;display:inline-block;text-decoration:none;border-right:1px solid #41cd52;color:#fff;}
  font1{color:#41cd52;font-size:35px;font-weight:bold;}
  font2{color:#41cd52;font-size:17px;font-weight:bold;vertical-align:top;}
  font5{color:#41cd52;font-size:8px;text-align:left;font-weight:normal;vertical-align:top;}
  .center{margin-left:auto;margin-right:auto;width:100%%;border:none;}
  .buttonn{background-color:#144964;border:none;color:white;padding:3px;text-align:center;text-decoration:none;display:inline-block;font-size:17px;margin:4px 2px;cursor:pointer;}
  .button1{border-radius:40%%;}
  a:link{color:blue;background-color:transparent;text-decoration:none;}
  </style>
</head>
<script src="%GAUGE_SOURCE%"></script>
<body onload="setSOC()">
  <button class="tablink"onclick="closeSocket();window.location.href=window.location.href;"id="defaultOpen"">Status</button> 
  <button class="tablink"onclick="closeSocket();window.location.href=window.location.href + 'batt';">Battery</button>
  <button class="tablink"onclick="closeSocket();window.location.href=window.location.href + 'graph';">Monitor</button>
  <button class="tablink"onclick="closeSocket();window.location.href=window.location.href + 'config';">Settings</button>
  <button class="tablink"onclick="closeSocket();window.location.href=window.location.href + 'fwupgrade';">Upgrade</button>
  <div id="Status"class="tabcontent">
  <canvas id="SOC"></canvas>
  <br>SOC <b><span id="soc"></span>&#37  <span id="don"></span></b><br>
  <span id="wbsts"></span>
  <br><b><span id="ctm"></span></b><span id="geo"></span><br>
  <br>Battery Pack V-I:<b> <span id="vol"></span></b> V ,<b><span id="cur"></span> </b> A
  <div id='packWattStatus'></div>
  Max SOC <b><span id="msc"></span>&#37</b> at <b><span id="mst"></span></b>
  <br>Remaining Capacity:&nbsp<b><span id="rcp"></span> Ah</b>                                                         
  <br>Package Temperature:&nbsp<b><span id="tav"></span> &#8451</b>
  <br>Average Batteries:&nbsp<b><span id="vav"></span> mV</b>
  <br>&#916V on <b><span id="cel"></span></b> Cells:&nbsp<b><span id="vdl"></span> mV</b>
  <br>BMS Chrg / Dischrg Cycles:&nbsp<b><span id="cyc"></span></b>                       
  <br>Discharge MOSFet Status:&nbsp<b><a id="SDM" href="#" class="nounderline" onclick="SwitchDisChargeMOS();return false;"></a></b>
  <br>Charge MOSFet Status:&nbsp<b><a id="CHM" href="#" class="nounderline" onclick="SwitchChargeMOS();return false;"></a></b>
  <br><span id="failure"></span>         
  <br>BMS Heartbeat:&nbsp<b><span id="hbt"></span></b>
  <br><br><a href="releasenote.html">FW Version:&nbsp<b><span id="fwv"></span></a></b>
  <font id="fwAvail"></font>
  <font id="fwStat"></font>
  <br><span id="val"></span>
</div>
<script>
var tID=0;
var gateway=`ws://${window.location.hostname}:${window.location.port}/ws`;
var websocket,IntervalId;
var disChargeFetState=0,chargeFetState=0,packWatts=0,fwStatus=1,newFWAvl=0,enMOS=0,wMode=1,fal=0,cellN=0;
var Clayout=255;
var onOpenTO=1500;
var battsNow=[]; 
var optsDY={
    angle:0,
    lineWidth:0.2,
    radiusScale:0.80,
    pointer:{
      length:0.60,
      strokeWidth:0.053,
      color:'#15ff00'  
    },
    limitMax:false,    
    limitMin:false,    
    generateGradient:true,
    highDpiSupport:true,    
    percentColors:[[0.0,"#e30e0e"],
    [0.5,"#e3dc0e"],
    [0.8,"#cae30e"],
    [1.0,"#0ee331"]
   ],   
    staticLabels:{
        font:"15px sans-serif", 
        labels:[0,25,50,75,90,100], 
        color:"#000000", 
        fractionDigits:0  
    },
};
window.addEventListener("beforeunload", function () {
    if (websocket && websocket.readyState === WebSocket.OPEN) {
        //websocket.send("wclose");
        websocket.close(3001, "page closing");
    }
});
function closeSocket(){
  clearInterval(IntervalId);
  websocket.close(3001,"force");
}
function onload(event){ 
  setTimeout(function(){initWebSocket();},1000);
  document.getElementById("wbsts").innerHTML="<br><font class=\"blink\"><b>Open Streaming ...</b></font><br>";
}
function startSequence(){tID=0;websocket.send("getBMSData 0");}
function initWebSocket(){
  console.log('WebSocket Init...');
  websocket=new WebSocket(gateway);
  websocket.onopen=onOpen;
  websocket.onclose=onClose;
  websocket.onmessage=onMessage;
  websocket.onerror=onError;
}
function onError(event){
  //console.log('WebSocket Error');
  clearInterval(IntervalId);
  setTimeout(function(){window.location.reload();},2000);
}
function onOpen(event){
  startSequence();
  IntervalId = setInterval(startSequence, 2000);
}
function onClose(event){
  //console.log('WebSocket Closed');
  clearInterval(IntervalId);
  if ( event.code !=3001 )
      setTimeout(function(){window.location.reload();},3000);
}
function onMessage(event){
  console.log(event.data);
  var myObj=JSON.parse(event.data);
  var keys;
  if (myObj) keys=Object.keys(myObj); else return;
  for (var i=0; i < keys.length; i++){
      var key=keys[i];      
      switch (key){
          case 'soc':var tmpSOC=myObj[key];document.getElementById(key).innerHTML=tmpSOC;setSOC(tmpSOC);break;
          case 'dfs':disChargeFetState=myObj[key];setCH_DSCH_MosStatus(0);break;             
          case 'cfs':chargeFetState=myObj[key];setCH_DSCH_MosStatus(1);break;            
          case 'lic':fwStatus=myObj[key];break;
          case 'nfa':newFWAvl=myObj[key];break; 
          case 'ems':enMOS=myObj[key];break;
          case 'wat':packWatts=myObj[key];break;
          case 'wmd':wMode=myObj[key];break;            
          case 'fal':fal=myObj[key];break;
          case 'cel':cellN=myObj[key];document.getElementById(key).innerHTML=myObj[key];break;
          case 'lay':Clayout=myObj[key];break;
          case 'lst':tID=myObj[key];break;
          case 'bat':battsNow=myObj[key];break;
          default:const element=document.getElementById(key);if (element) element.innerHTML=myObj[key];break;
      }
  }
  if (tID == 255){updRTdata();} else {websocket.send("getBMSData " + tID);}
}
function openTab(color){
  var i,tabcontent,tablinks,boxName;
  tabcontent=document.getElementsByClassName("tabcontent");
  for (i=0; i < tabcontent.length; i++){
    tabcontent[i].style.display="none";
  }
  tablinks=document.getElementsByClassName("tablink");
  for (i=0; i < tablinks.length; i++){
    tablinks[i].style.backgroundColor="";
  }
  boxName = document.getElementById("defaultOpen").textContent;
  document.getElementById(boxName).style.display="block";
  document.getElementById("defaultOpen").style.backgroundColor=color;
}
function SwitchDisChargeMOS(){
  var urltocall="/SwMOS?switch=dis" + "&set=" + !disChargeFetState ;
  var msg=disChargeFetState?"OFF":"ON";
  if (!enMOS){alert("Feature disabled - enable it on MISC page");return;}
  xmlhttp=new XMLHttpRequest();
 {
     if (confirm("Switch " + msg  + " DISCHARGE MOS ?")==true){
       xmlhttp.open("GET",urltocall,false);
       xmlhttp.send();
       disChargeFetState=!disChargeFetState;
       setCH_DSCH_MosStatus(0);
       websocket.close();
     }
  }
}
function SwitchChargeMOS(){
  var urltocall="/SwMOS?switch=crg" + "&set=" + !chargeFetState ;
  var msg=chargeFetState?"OFF":"ON";
  if (!enMOS){alert("Feauture disabled - enable it on MISC page");return;}
  xmlhttp=new XMLHttpRequest();
 {
     if (confirm("Switch " + msg + " CHARGE MOS ?")==true){
       xmlhttp.open("GET",urltocall,false);
       xmlhttp.send();
       chargeFetState=!chargeFetState;
       setCH_DSCH_MosStatus(1);
       websocket.close();
     }
  }
}
function setSOC(theSoc){
  var target=document.getElementById('SOC'); 
  var gauge;
  gauge=new Gauge(target).setOptions(optsDY);
  gauge.maxValue=100; 
  gauge.setMinValue(0);  
  gauge.animationSpeed=1; 
  gauge.set(theSoc); 
}
function setCH_DSCH_MosStatus( ch_dsch ){
  var theChDisChargMOSStatus;
  var theChDisChCurrStatus;
  if (ch_dsch){
    theChDisChargMOSStatus=document.getElementById('CHM');
    theChDisChCurrStatus=chargeFetState ;
  }else{
    theChDisChargMOSStatus=document.getElementById('SDM');
    theChDisChCurrStatus=disChargeFetState ;
  }
  var DSMText="<font style=\"color:";
  if ( theChDisChCurrStatus )
    DSMText +="green;\">ON"; 
  else
    DSMText +="red;\">OFF";
  DSMText +="</font>";
  theChDisChargMOSStatus.innerHTML=DSMText;
}  
function updRTdata(){
    var element;
    tID=0;
    document.getElementById("wbsts").innerHTML="";
    var theStatus=document.getElementById('packWattStatus');
    if ( packWatts==0 )
      theStatus.innerHTML="<font color=\"black\">RELAXING <b>" + packWatts + " W</b></font>";
    if ( packWatts > 0 )
      theStatus.innerHTML="<font color=\"green\">CHARGING <b>" + packWatts + " W</b></font>";
    if ( packWatts < 0 )
      theStatus.innerHTML="<font color=\"red\">DISCHARGING <b>" + packWatts + " W</b></font>";
    if (!fwStatus)
      document.getElementById("fwStat").innerHTML="<br><a id=\"unLicensed\" href=\"license.html\"><font class=\"blink\"><b>ACTIVATE</b></font></a>";
    else
      document.getElementById("fwStat").innerHTML="";
    if (newFWAvl )
      document.getElementById("fwAvail").innerHTML="<br><a href=\"https://www.dalybmswifi.com/fwrels/\"><font class=\"blink\"><b>NEW FIRMWARE</b></font></a>";    

    var failStr="<a href=\"/bmsalarms\" style=\"color:";
    if (!fal)
        failStr+="green\">No Alarms";
    else
        failStr+="red\"><b>Alarms</b>";
    failStr+="</a>";
    element=document.getElementById("failure");
    if (element) element.innerHTML=failStr;
}
function populateGeo(){
  var geoStr ="<br>SunRise <b><span id=\"sri\"></span></b> - SunSet <b><span id=\"sst\"></span></b> <span title=\"daylight difference vs yesterday\">(<span id=\"ddu\"></span>s)</span><br><span title=\"click to see a week forecast\"><a href=\"\" onclick=\"openWeatherWindow()\" style=\"text-decoration:none;color:black\"> Today <b><span id=\"wtd\"></span></b></b>  Frcst <b><span id=\"wtm\"></span></b></a></span>";
  if ( %geo% )
    document.getElementById("geo").innerHTML=geoStr;
  else
    document.getElementById("geo").innerHTML="<br><a href=\"/config\"><font class=\"blink\"><b>SET PLANT COORDINATES TO SYNC TIME</b></font></a>"
}
function openWeatherWindow(){
  if ( wMode )
    window.open("%weatherLink%","Weather","width=500,height=120");
}
window.addEventListener('load',onload());
openTab('red');
populateGeo();
</script>
</body>
</html> 
<!--FFILE-->
<!--HFILE:graph-rep.html--> 
<!doctype html><html lang=en><head><meta charset=UTF-8><title>SmartBMS data Extractor Battery Telemetry</title><meta name=viewport content="width=device-width,initial-scale=1"><script src=/HC.js></script><style>
body{margin:0;font-family:sans-serif;background:#fff;color:#000;transition:.3s}
header{padding:14px}.title{font-size:1.2rem;font-weight:600;color:#0af;text-transform:uppercase}
.subtitle{font-size:.85rem;color:#555}#chart{width:100%%;height:70vh}
.reload{padding:8px;font-size:.8rem;cursor:pointer;color:#f06}
.packets{padding:8px;font-size:.8rem;color:#555}.status{padding:4px 8px;font-size:.7rem;color:#777}
.top-right-controls{position:absolute;top:10px;right:10px;display:flex;flex-direction:column;gap:6px;z-index:9999;align-items:flex-end}
.control-row{display:flex;align-items:center;gap:6px;font-size:.75rem;color:#08f}
.switch{position:relative;width:38px;height:18px;background:#777;border-radius:18px;cursor:pointer;transition:.25s}
.switch::after{content:"";position:absolute;width:14px;height:14px;background:#fff;border-radius:50%%;top:2px;left:2px;transition:.25s}
.switch.on{background:#00c8ff}.switch.on::after{left:22px}
.dark{background:#0b1020!important;color:#e5e9f0!important}
</style></head>

<body class=light>
<header><div class=title>Battery Telemetry</div><div class=subtitle>SmartBMS Data Extractor Log Viewer</div></header>

<div class=top-right-controls>
<div class=control-row><div id=themeLabel>Light Mode</div><div id=themeSwitch class="switch on" onclick=toggleTheme()></div></div>
<div class=control-row><div id=autoLabel>Auto Reload</div><div id=autoSwitch class=switch onclick=toggleAutoReload()></div></div>
</div>

<div id=chart></div>

<div style="display:flex;justify-content:space-between;padding:10px;font-size:.8rem;color:#555;gap:20px">
<div style="flex:1;min-width:140px">
<button class=reload onclick=triggerFromESP()>Reload</button>
<div class=packets id=packets>Packets: 0 | 0 KB</div>
<div class=status id=status></div>
</div>

<div style="flex:1;min-width:180px;text-align:right">
<div style=margin-bottom:6px>Power smoothing:<input id=smoothP type=range min=0 max=20 value=0 step=1 style=width:120px><span id=smoothPval>0</span></div>
<div style=margin-bottom:6px>Vbat smoothing:<input id=smoothV type=range min=0 max=20 value=15 step=1 style=width:120px><span id=smoothVval>15</span></div>
<div style=margin-bottom:6px>SOC smoothing:<input id=smoothS type=range min=0 max=20 value=15 step=1 style=width:120px><span id=smoothSval>15</span></div>
<div style=margin-bottom:6px>Delta smoothing:<input id=smoothD type=range min=0 max=20 value=5 step=1 style=width:120px><span id=smoothDval>5</span></div>
</div>
</div>
<script>
var chart=null,firstInit=!0,autoReload=!1,autoReloadTimer=null,packetCount=0,logBuffer=new Uint8Array(0),
seriesState=[!0,!1,!1,!1],smoothP=0,smoothV=15,smoothS=15,smoothD=5,logFileSize=0;

function setStatus(e){document.getElementById("status").textContent=e}

function toggleAutoReload(){
var e=document.getElementById("autoSwitch"),t=document.getElementById("autoLabel");
(autoReload=e.classList.toggle("on"))?(t.textContent="Auto Reload ON",autoReloadTimer=setInterval(triggerFromESP,6e4)):(t.textContent="Auto Reload",clearInterval(autoReloadTimer),autoReloadTimer=null)
}

function parseBinaryLog(e){
var t=new DataView(e.buffer),o=0,a=0,s=0,n=[],r=[],i=[],l=[];
for(t.byteLength>=6&&65535===t.getUint16(0,!0)&&(a=t.getUint32(2,!0),o=6);o<t.byteLength&&!(o+2>t.byteLength);){
var h=t.getUint16(o,!0);o+=2;
var c=h>>13,u=1e3*(a+(s+=8191&h));
if(0===c){
if(o+2>t.byteLength)break;
n.push([u,t.getInt16(o,!0)]),o+=2
}else{
if(1!==c)break;
if(o+6>t.byteLength)break;
var d=t.getUint8(o);o++;
var m=t.getUint16(o,!0);o+=2;
var f=t.getUint16(o,!0);o+=2;o++;
r.push([u,d]),i.push([u,m]),l.push([u,f/10])
}}
return{p:n,s:r,d:i,v:l}
}

function smoothSeries(e,t){
if(t<=0||e.length<3)return e;
let o=[];
for(let a=0;a<e.length;a++){
let s=0,n=0;
for(let o=a-t;o<=a+t;o++)o>=0&&o<e.length&&(s+=e[o][1],n++);
o.push([e[a][0],s/n])
}
return o
}

function buildDashedSeries(e,t){
if(e.length<2)return[];
for(var o=[],a=1;a<e.length;a++){
var s=e[a-1],n=e[a];
n[0]-s[0]>3e5&&o.push({name:"gap_"+t,type:"spline",turboThreshold:0,linecap:"round",data:[[s[0]-1,s[1]],s,n],dashStyle:"Dash",color:null,enableMouseTracking:!1,tooltip:{enabled:!1},marker:{enabled:!1},lineWidth:2,animation:!1,showInLegend:!1})
}
return o
}

function updateAxisVisibility(){
if(chart){
var e=chart.yAxis;
e[0].update({title:{text:chart.series.some((e=>"Power"===e.name&&e.visible))?"[W]":""}},!1),
e[1].update({title:{text:chart.series.some((e=>"Vbat"===e.name&&e.visible))?"[V]":""}},!1),
e[2].update({title:{text:chart.series.some((e=>"SOC"===e.name&&e.visible))?"%%":""}},!1),
e[3].update({title:{text:chart.series.some((e=>"Delta"===e.name&&e.visible))?"mV":""}},!1),
chart.redraw()
}}
function createChart(e){
if(chart){
seriesState=[];
for(var t=0;t<chart.series.length;t++)seriesState.push(chart.series[t].visible);
chart.destroy()
}

smoothP>0&&(e.p=smoothSeries(e.p,smoothP)),
smoothV>0&&(e.v=smoothSeries(e.v,smoothV)),
smoothS>0&&(e.s=smoothSeries(e.s,smoothS)),
smoothD>0&&(e.d=smoothSeries(e.d,smoothD));

var o=buildDashedSeries(e.p,"power"),
a=buildDashedSeries(e.v,"vbat"),
s=buildDashedSeries(e.s,"soc"),
n=buildDashedSeries(e.d,"delta"),
r=document.body.classList.contains("dark"),
i=[];

i.push({name:"Power",type:"spline",data:e.p,yAxis:0,zones:[{value:0,color:"#ff4444"},{color:"#22cc22"}]}),
o.forEach(e=>i.push(e)),
i.push({name:"Vbat",type:"spline",data:e.v,yAxis:1,color:"#fdd835",visible:!1}),
a.forEach(e=>i.push(e)),
i.push({name:"SOC",type:"spline",data:e.s,yAxis:2,color:"#a855f7",visible:!1}),
s.forEach(e=>i.push(e)),
i.push({name:"Delta",type:"spline",data:e.d,yAxis:3,color:"#f97316",visible:!1}),
n.forEach(e=>i.push(e));

chart=Highcharts.chart("chart",{
chart:{backgroundColor:r?"#0b1020":"#fff",zoomType:"x",marginTop:50},
accessibility:{enabled:!1},
legend:{enabled:!0,useHTML:!0,itemStyle:{color:r?"#e5e9f0":"#000"},labelFormatter:function(){return this.name.startsWith("gap_")?"":this.name}},
title:{text:""},
credits:{enabled:!0},
xAxis:{type:"datetime",labels:{style:{color:r?"#aaa":"#000"}}},
plotOptions:{spline:{linecap:"round",animation:!1,softThreshold:!0,tension:.45},series:{turboThreshold:0,stickyTracking:!1,marker:{enabled:!1},lineWidth:2}},
yAxis:[
{title:{text:"[W]",rotation:0,align:"high",y:-5,x:10,style:{color:"#38bdf8",fontSize:"11px"}},labels:{style:{color:"#38bdf8",fontSize:"10px"}},offset:10},
{title:{text:"Vbat",rotation:0,align:"low",y:20,x:10,style:{color:"#22c55e",fontSize:"11px"}},labels:{style:{color:"#22c55e",fontSize:"10px"}},offset:50},
{title:{text:"SOC",rotation:0,align:"high",y:-5,x:-10,style:{color:"#a855f7",fontSize:"11px"}},labels:{style:{color:"#a855f7",fontSize:"10px"}},opposite:!0,offset:10},
{title:{text:"Delta",rotation:0,align:"low",y:20,x:-10,style:{color:"#f97316",fontSize:"11px"}},labels:{style:{color:"#f97316",fontSize:"10px"}},opposite:!0,offset:50}
],
tooltip:{shared:!1,useHTML:!1,crosshairs:!0,snap:0,formatter:function(){
if(this.series.name.startsWith("gap_"))return!1;
var e="Power"===this.series.name?" W":"Vbat"===this.series.name?" V":"SOC"===this.series.name?" %%":"Delta"===this.series.name?" mV":"";
return Highcharts.dateFormat("%%H:%%M:%%S",this.x)+" | "+this.series.name+": "+this.y.toFixed(1)+e
}},
series:i
});

chart.series.forEach(e=>{e.update({events:{show:updateAxisVisibility,hide:updateAxisVisibility}},!1)});
updateAxisVisibility();

if(firstInit){
chart.series.forEach(e=>{"Power"===e.name||"gap_power"===e.name?e.show():e.hide()});
firstInit=!1
}else{
for(t=0;t<chart.series.length;t++)seriesState[t]?chart.series[t].show():chart.series[t].hide()
}
}

function toggleTheme(){
var e=document.getElementById("themeSwitch"),t=document.getElementById("themeLabel");
e.classList.toggle("on")?(document.body.classList.remove("dark"),t.textContent="Light Mode"):(document.body.classList.add("dark"),t.textContent="Dark Mode"),
createChart(parseBinaryLog(logBuffer))
}

function openWsOnce(){
setStatus("Opening WebSocket...");
logBuffer=new Uint8Array(0);
packetCount=0;
document.getElementById("packets").textContent="Packets: 0 | 0 KB";

var e=new WebSocket("ws://"+location.host+"/ws");
e.binaryType="arraybuffer";

e.onopen=function(){e.send("GET_LOG")};

e.onmessage=function(t){
if("#END"===t.data){
createChart(parseBinaryLog(logBuffer));
e.close();
return;
}
const msg = String(t.data);
if (msg.startsWith("#LSIZE:")) {logFileSize = parseInt(msg.substring(7), 10);}
if(t.data instanceof ArrayBuffer){
var o=new Uint8Array(t.data),a=new Uint8Array(logBuffer.length+o.length);
a.set(logBuffer);
a.set(o,logBuffer.length);
logBuffer=a;
packetCount++;
var kb=(logBuffer.length/1024).toFixed(1);
var prg = ((logBuffer.length/logFileSize) * 100).toFixed(0) + "%";
document.getElementById("packets").textContent="Packets: "+packetCount+" | "+kb+" KB "+prg;
logFileSize
}
};

e.onerror=function(){setStatus("WebSocket Error")};
e.onclose=function(){setStatus("WebSocket Closed")};
}

function triggerFromESP(){
fetch("/openws?rand="+Math.random())
.then(e=>e.text())
.then(js=>eval(js));
}

document.addEventListener("DOMContentLoaded",function(){
document.getElementById("smoothP").oninput=function(){smoothP=parseInt(this.value);document.getElementById("smoothPval").textContent=this.value;createChart(parseBinaryLog(logBuffer))};
document.getElementById("smoothV").oninput=function(){smoothV=parseInt(this.value);document.getElementById("smoothVval").textContent=this.value;createChart(parseBinaryLog(logBuffer))};
document.getElementById("smoothS").oninput=function(){smoothS=parseInt(this.value);document.getElementById("smoothSval").textContent=this.value;createChart(parseBinaryLog(logBuffer))};
document.getElementById("smoothD").oninput=function(){smoothD=parseInt(this.value);document.getElementById("smoothDval").textContent=this.value;createChart(parseBinaryLog(logBuffer))};
setTimeout(triggerFromESP,500);
});
</script>
</body></html>

<!--FFILE-->
<!--HFILE:IoTMQTTPanel.html--> 
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>JSON IoTMQTTPanel Trimmer</title>
<style>
body {
    font-family: Arial, sans-serif;
    margin: 16px;
    max-width: 900px;
}
h2, h3 {
    margin-top: 10px;
}
button {
    margin-top: 12px;
    padding: 10px 16px;
    font-size: 16px;
    width: 100%;
    max-width: 240px;
}
pre {
    background: #f0f0f0;
    padding: 10px;
    border-radius: 6px;
    max-height: 400px;
    overflow: auto;
    font-size: 14px;
}
img {
    margin-top: 20px;
    border-radius: 6px;
    width: 100%;
    height: auto;
    max-width: 300px;
}
@media (min-width: 600px) {
    button {
        width: auto;
    }
    pre {
        font-size: 15px;
    }
}
</style>
</head>
<body>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pako/2.1.0/pako.min.js"></script>
<h2>JSON IoTMQTTPanel Trimmer</h2>
<button id="btnDownload">Download</button>
<h3>Output JSON (non-minified):</h3>
<pre id="out"></pre>
<p>Example of panel layout generated by the dongle</p>
<img src="https://dalybmswifi.com/img/iotMQTT_Panel.jpg" alt="iotMQTTPanel in action">
<script>
function randomClientID(len=8) {
    const chars="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
    let out="";
    for (let i=0;i<len;i++) out+=chars.charAt(Math.floor(Math.random()*chars.length));
    return out;
}
let numOfBatts=%numberOfCells%;
const mqttJsonTopic="%mqttJsonTopic%";
const mqttClientID=randomClientID(8);
const mqttServer="%mqttServer%";
const mqttPort=%mqttPort%;
const mqttSecText="%mqttSecText%";
const mqttUserName="%mqttUserName%";
const mqttPassword="%mqttPassword%";
let mqttRefresh=%mqttRefresh%;
const mqttMOS=("%enMOS%"=="checked")?1:0;
if (mqttRefresh<60) mqttRefresh=60;
function applyTagReplacements(content) {
    content=content.replaceAll("*!mqttJsonTopic*!",mqttJsonTopic);
    content=content.replaceAll("*!mqttClientID*!",mqttClientID);
    content=content.replaceAll("*!mqttServer*!",mqttServer);
    content=content.replaceAll("*!mqttPort*!",mqttPort);
    content=content.replaceAll("*!mqttSecText*!",mqttSecText);
    content=content.replaceAll("*!mqttUserName*!",mqttUserName);
    content=content.replaceAll("*!mqttPassword*!",mqttPassword);
    content=content.replaceAll("*!mqttRefresh*!",mqttRefresh);
    content=content.replaceAll("*!numberOfCells*!",numOfBatts);
    return content;
}
function trimAllBatteriesPanelsImmutable(json,num) {
    return {
        ...json,
        panels: json.panels.map(p => {
            if (typeof p.panelName==="string" &&
                p.panelName.toLowerCase().includes("batteries") &&
                Array.isArray(p.comboItemList)) {
                return { ...p, comboItemList: p.comboItemList.slice(0,num) };
            }
            return p;
        })
    };
}
function minifyJson(input) {
    const obj=(typeof input==="string")?JSON.parse(input):input;
    return JSON.stringify(obj);
}
function downloadFile(text,filename) {
    const blob=new Blob([text],{type:"application/json"});
    const url=URL.createObjectURL(blob);
    const a=document.createElement("a");
    a.href=url;
    a.download=filename;
    a.click();
    URL.revokeObjectURL(url);
}
document.addEventListener("DOMContentLoaded",() => {
    document.getElementById("btnDownload").addEventListener("click",async() => {
        const num=numOfBatts;
        try {
            const resp=await fetch("./IoTMQTTPanel.json.gz");
            const compressed=new Uint8Array(await resp.arrayBuffer());
            let content=pako.ungzip(compressed,{to:"string"});
            content=applyTagReplacements(content);
            const original=JSON.parse(content);
            const trimmed=trimAllBatteriesPanelsImmutable(original,num);
            document.getElementById("out").textContent=JSON.stringify(trimmed,null,2);
            const minified=minifyJson(trimmed);
            downloadFile(minified,"IoTMQTTPanel.json");
        } catch(e) {
            document.getElementById("out").textContent="Error loading or parsing JSON: "+e;
        }
    });
});
</script>
</body>
</html>
<!--FFILE-->
