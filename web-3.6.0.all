<!DOCTYPE HTML><html>
<head>
<title>ScanLabs SMART BMS DATA EXTRACTOR</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
body{min-width:310px;max-width:1000px;height:400px;margin:0 auto;font-family:"Lato",sans-serif;}
h2{text-align:center;font-family:Arial;font-size:2.5rem;}
.tablink{background:#e0e0e0;color:#333;float:left;border:none;border-radius:10px;cursor:pointer;padding:6px 12px;font-size:11px;font-weight:600;width:20%%;margin:3px 0;text-align:center;transition:.25s;box-shadow:0 1px 2px rgba(0,0,0,.08);}
.tablink:hover{background:#d5d5d5;transform:translateY(-2px);box-shadow:0 2px 4px rgba(0,0,0,.12);}
.tablink.active{background:#00978f;color:#fff;transform:translateY(-2px);box-shadow:0 2px 4px rgba(0,0,0,.15);}
.tabcontent{display:none;padding:20px;text-align:center;}
.btn-group button{background:#04AA6D;border:1px solid green;border-radius:12px;margin:4px 2px;color:#fff;padding:10px 24px;cursor:pointer;float:left;}
.btn-group button:hover{background:#3e8e41;}
#unLicensed{color:red;text-decoration:none}
.dipWrap{display:flex;align-items:center;gap:6px;}
.dipBox{
  width:20px;height:35px;border:2px solid #333;border-radius:4px;
  background:#f0f0f0;position:relative;display:flex;
  justify-content:center;align-items:flex-end;padding-bottom:3px;
  font-size:10px;font-weight:bold;color:#333;cursor:pointer;
  user-select:none;
}
.dipLever{
  width:13px;height:14px;background:#ccc;border:2px solid #333;
  border-radius:3px;position:absolute;left:50%%;
  transform:translateX(-50%%);transition:.2s;
}
.dipOn .dipLever{top:3px;background:#00978f;border-color:#006b66;}
.dipOff .dipLever{bottom:3px;background:#ddd;}
#dipContainer{display:flex;gap:12px;justify-content:center;margin-top:10px;}
.dipLabel{font-size:10px;font-weight:bold;color:#333;}
</style>
</head>
<script>
let initialProt = null;
let initialID = null;
function submitMessage(){
  let prot = document.getElementById("bmsProt")?.value;
  let id   = document.getElementById("bmsdID")?.value;
  if (initialProt !== null && initialID !== null) {
    if (prot != initialProt || id != initialID) {
      alert("! A dongle reset/restart is required for the changes to take effect !");
    }
  }
  setTimeout(()=>{location.reload()},2000);
}
function openTab(c){
  [...document.getElementsByClassName("tabcontent")].forEach(e=>e.style.display="none");
  [...document.getElementsByClassName("tablink")].forEach(e=>e.style.backgroundColor="");
  let box=document.getElementById("defaultOpen").textContent;
  document.getElementById(box).style.display="block";
  document.getElementById("defaultOpen").style.backgroundColor=c;
}
function setSOC(){
  let v=document.getElementById("cSOC").value;
  if(!v) return;
  let x=new XMLHttpRequest();
  x.open("GET","/setmisc?sSOC="+v,false); x.send();
  setTimeout(()=>location.reload(),2000);
}
</script>
<body>
<button class="tablink" onclick="location.href='/'">Status</button>
<button class="tablink" onclick="location.href='/batt'">Battery</button>
<button class="tablink" onclick="location.href='/graph'">Monitor</button>
<button class="tablink" onclick="location.href='/config'" id="defaultOpen">Settings</button>
<button class="tablink" onclick="location.href='/fwupgrade'">Upgrade</button>
<div id="Settings" class="tabcontent"></div>
<div style="margin:15px;">
<br><center><b>MISC CONFIG</b></center><br>
<center>%getFreeHeap% Bytes</center>
<center><font id="fwStat"></font></center><br>
<hr><br>
<form action="/getmisc" target="hidden-form">
<span title="Midnight System Reset">MidNight SYS Reset: <input type="checkbox" name="inputSYSRES" %inputSYSRES%></span><br>
<span title="BMS Reset when communication error">BMS Reset: <input type="checkbox" name="inputBMSRES" %inputBMSRES%></span><br>
<span title="Reset on Missing Wireless">Wireless SYS Reset: <input type="checkbox" name="inputSYSRESW" %inputSYSRESW%></span><br>
<span title="Reset Button to switch to AP/Factory">Enable Reset button: <input type="checkbox" name="SysResToAP" %SysResToAP%></span><br>
<span title="Firmware Automatic Upgrade">Auto FW Upgrade: <input type="checkbox" name="SysOTA" %SysOTA%></span><br><br>
<span title="Enable JK Layout">JK Layout: <input type="checkbox" name="sysLyt" %sysLyt%></span><br><br>
<span title="Enable Setting MOS Switches">MOS Managment: <input type="checkbox" name="enMOS" %enMOS%></span><br>
<p id="bmsfeature"></p>
<span title="BMS Refresh in seconds it is suggested to set >5s">
BMS Data Refresh [s] <input type="number" min="1" max="300" step="1" name="bmsRefresh" id="bmsRefresh" value="%bmsRefresh%">
</span>
<span id="mSOC"></span><br><br>
<input type="submit" value="Submit" onclick="submitMessage()"><br><br>
</form>
<hr><br>
<div class="btn-group"><button onclick="location.href='config'">BACK to CONFIG</button></div>
<iframe style="display:none" name="hidden-form"></iframe>
</div>
<script>
if(!%fwStatus%){
  bmsRefresh.disabled=true;
  fwStat.innerHTML="<br><a id='unLicensed' href='license.html'><b>ACTIVATE</b></a><br>";
}
if(%bmsKind%==0){
  let t="<span title='Daly Protocol type1 (newer) or type0'>DALY Protocol: <select name='bmsProt' id='bmsProt'>\
  <option value='0'> Former Protocol </option>\
  <option value='1'> Newer Protocol </option></select></span><br>\
  <span title='Enable passthrough between DALY bluetooth/WiFi dongle and BMS'>BMS Passthrough: <input type='checkbox' name='inputBMSREP' %inputBMSREP%></span><br>";
  if(%hasLog%) t+="<span title='Enable BMS logger'>BMS Log: <input type='checkbox' name='inputBMSLOG' %inputBMSLOG%></span><br>";
  bmsfeature.innerHTML=t;
  mSOC.innerHTML="<br><span title='Set Current SOC 0-100'>Current SOC <input type='number' min='0' max='100' id='cSOC'></span>\
  &emsp;<input type='button' onclick='setSOC()' value='set SOC'><br>";
}else{
  let t="<span title='Select the same JK Protocol on the dongle and BMS'>JK Protocol: <select name='bmsProt' id='bmsProt'>\
  <option value='0'>000 - 4G-GPS Remote module Common protocol V4.2</option>\
  <option value='1'>001 - JK BMS RS485 Modbus V1.0</option>\
  <option value='2'>002 - JK BMS CAN</option></select></span><br>";
  t+="<div style='display:flex; align-items:center; gap:20px; justify-content:flex-start; margin-top:10px;'>\
        <span title='Select JK Device ID (0–15)'>JK Device ID: \
          <input type='number' min='0' max='15' name='bmsdID' id='bmsdID' value='%bmsdID%' oninput='updateDipSwitches()'>\
        </span>\
        <div id='dipContainer' style='display:flex; flex-direction:row; gap:10px;'>\
          <div class='dipBox dipOff' id='dip1' onclick='toggleDip(1)'><div class='dipLever'></div>1</div>\
          <div class='dipBox dipOff' id='dip2' onclick='toggleDip(2)'><div class='dipLever'></div>2</div>\
          <div class='dipBox dipOff' id='dip3' onclick='toggleDip(3)'><div class='dipLever'></div>3</div>\
          <div class='dipBox dipOff' id='dip4' onclick='toggleDip(4)'><div class='dipLever'></div>4</div>\
        </div>\
        <div class='dipLabelSide' style='margin-left:10px; display:flex; flex-direction:column; justify-content:space-between; height:40px;'>\
          <span>ON</span>\
          <span>OFF</span>\
        </div>\
      </div><br>";
  bmsfeature.innerHTML=t;
}
openTab('red');
bmsProt.value="%bmsProt%";
function toggleDip(n){
  let dip=document.getElementById("dip"+n);
  dip.classList.toggle("dipOn");
  dip.classList.toggle("dipOff");

  let val=0;
  for(let i=0;i<4;i++){
    let d=document.getElementById("dip"+(i+1));
    if(d.classList.contains("dipOn")) val|=(1<<i);
  }
  document.getElementById("bmsdID").value=val;
}
function updateDipSwitches(){
  let id=parseInt(document.getElementById("bmsdID").value);
  if(isNaN(id)||id<0||id>15) return;

  for(let i=0;i<4;i++){
    let dip=document.getElementById("dip"+(i+1));
    if(id&(1<<i)){
      dip.classList.add("dipOn"); dip.classList.remove("dipOff");
    }else{
      dip.classList.add("dipOff"); dip.classList.remove("dipOn");
    }
  }
}
document.addEventListener("DOMContentLoaded",()=>{
  updateDipSwitches();
  initialProt = document.getElementById("bmsProt")?.value;
  initialID   = document.getElementById("bmsdID")?.value;
});
</script>
</body>
</html>
