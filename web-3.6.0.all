      content += String.fromCharCode(config_json[i]);
   }

   content = content.replaceAll("*!wifiSSID*!", wiFiSSID  );
   content = content.replaceAll("*!wifiPWD*!", wifiPWD  );
   content = content.replaceAll("*!mqttServer*!", mqttServer  );
   content = content.replaceAll("*!mqttPort*!", mqttPort  );
   content = content.replaceAll("*!mqttUserName*!", mqttUserName  );
   content = content.replaceAll("*!mqttPassword*!", mqttPassword  );
   content = content.replaceAll("*!openHaspPanelID*!", openHaspPanelID );

   const file = new Blob([content], { type: 'text/plain' });
   link.href = URL.createObjectURL(file);
   link.download = "config.json";
   link.click();
   URL.revokeObjectURL(link.href);
};

const downloadPanelFile = () => {
   const link = document.createElement("a");
   let content = "";
   for (let i = 0; i < scanlabs_jsonl.length; i++) {
      content += String.fromCharCode(scanlabs_jsonl[i]);
   }
   if ( mqttMOS ){        
   }
   content = content.replaceAll("*!openHaspPanelID*!", openHaspPanelID );
 
   const file = new Blob([content], { type: 'text/plain' });
   link.href = URL.createObjectURL(file);
   link.download = "scanlabs.jsonl";
   link.click();
   URL.revokeObjectURL(link.href);
};
const downloadExtraFile = ( dataSource, fileName ) => {
   const link = document.createElement("a");
   let content = "";
   for (let i = 0; i < dataSource.length; i++) {
      content += String.fromCharCode(dataSource[i]);
   } 
   const file = new Blob([content], { type: 'text/plain' });
   link.href = URL.createObjectURL(file);
   link.download = fileName;
   link.click();
   URL.revokeObjectURL(link.href);
};

function downloadAllConfFile(){
   downloadConfigFile();
   downloadPanelFile();
   downloadExtraFile( online_cmd, "online.cmd");
   downloadExtraFile( offline_cmd, "offline.cmd");
   downloadExtraFile( idle_off_cmd, "idle_off.cmd");
   downloadExtraFile( idle_short_cmd, "idle_short.cmd");
   downloadExtraFile( idle_long_cmd, "idle_long.cmd");
}   
function submitMessage() {
  dashBoardConfig(0);
  setTimeout(function(){ document.location.reload(false); }, 2000);
}
function openTab(color){
  var i,tabcontent,tablinks,boxName;
  tabcontent=document.getElementsByClassName("tabcontent");
  for (i=0; i < tabcontent.length; i++){
    tabcontent[i].style.display="none";
  }
  tablinks=document.getElementsByClassName("tablink");
  for (i=0; i < tablinks.length; i++){
    tablinks[i].style.backgroundColor="";
  }
  boxName = document.getElementById("defaultOpen").textContent;
  document.getElementById(boxName).style.display="block";
  document.getElementById("defaultOpen").style.backgroundColor=color;
}
function dashBoardConfig( extcomp ){ //1-extract 0-compress
  let dashBoardCfg1=%TaD1%;   
  let dashBoardCfg2=%TaD2%;

  if ( extcomp ){
    let chartEnabled=(dashBoardCfg1 & 0x04000000)?1:0;
    let chartTimeSpan=(dashBoardCfg1 & 0xF8000000)>>27;
    let autoRolling=(dashBoardCfg1 & 0x02000000)?1:0;
    let autoBrightness=(dashBoardCfg1 & 0x01000000)?1:0;
    let brLevelMax=(dashBoardCfg1 & 0x00FF0000)>>16;
    let brLevelAvg=(dashBoardCfg1 & 0x0000FF00)>>8;
    let brLevelMin=(dashBoardCfg1 & 0x000000FF)>>0;

    let autoRollSec=(dashBoardCfg2 & 0xFF000000)>>24;
    let brLevelMaxS=(dashBoardCfg2 & 0x00FFF000)>>12;
    let brLevelAvgS=(dashBoardCfg2 & 0x00000FFF)>>0;

    document.getElementById("ChEn").checked=chartEnabled;
    document.getElementById("ChT").value=chartTimeSpan;
    document.getElementById("AuRo").checked=autoRolling;
    document.getElementById("ROs").value=autoRollSec;
    document.getElementById("AuBE").checked=autoBrightness;
    document.getElementById("bMx").value=brLevelMax;
    document.getElementById("bMe").value=brLevelAvg;
    document.getElementById("bLw").value=brLevelMin;
    document.getElementById("bMxs").value=brLevelMaxS;
    document.getElementById("bMes").value=brLevelAvgS;
 }else
 {
    dashBoardCfg1 = document.getElementById("ChEn").checked?(1<<26):0;  
    dashBoardCfg1+= ((document.getElementById("ChT").value & 0xFF)<<27);
    dashBoardCfg1+= document.getElementById("AuRo").checked?(1<<25):0;
    dashBoardCfg1+= document.getElementById("AuBE").checked?(1<<24):0;
    dashBoardCfg1+= ((document.getElementById("bMx").value & 0xFF)<<16);
    dashBoardCfg1+= ((document.getElementById("bMe").value & 0xFF)<<8);
    dashBoardCfg1+= (document.getElementById("bLw").value & 0xFF);
    
    dashBoardCfg2 = (document.getElementById("ROs").value & 0xFF) <<24;
    dashBoardCfg2+= (document.getElementById("bMxs").value & 0xFFF) << 12;
    dashBoardCfg2+= (document.getElementById("bMes").value & 0xFFF) << 0;

    var urltocall="/get_oh?TaD1="+dashBoardCfg1+"&TaD2="+dashBoardCfg2;
    xmlhttp=new XMLHttpRequest();
    xmlhttp.open("GET", urltocall, false);
    xmlhttp.send();
 }
}
function DoChecks(parIn){
  document.getElementById("DyPg").value&=0xFF;
  if ( !document.getElementById("DyPg").value)
    document.getElementById("DyPg").value=1;
  if ( document.getElementById("TaEn").checked && parIn==0){
    document.getElementById("oHEn").checked=false;
  }
  if ( document.getElementById("oHEn").checked && parIn==1){
    document.getElementById("TaEn").checked=false;
  }
  if ( document.getElementById("oHEn").checked==true || document.getElementById("TaEn").checked==false ||
   document.getElementById("DyPg").value!=1){
    document.getElementById("AuRo").disabled=document.getElementById("ROs").disabled=true;
    document.getElementById("ChEn").disabled=document.getElementById("ChT").disabled=true;
    document.getElementById("AuBE").disabled=true;
    document.getElementById("bMx").disabled=document.getElementById("bMe").disabled=document.getElementById("bLw").disabled = true;
    document.getElementById("bMxs").disabled =document.getElementById("bMes").disabled=true;
  }
  if ( document.getElementById("TaEn").checked==true &&
   document.getElementById("DyPg").value==1){
    document.getElementById("ChEn").disabled=document.getElementById("ChT").disabled=false;
    document.getElementById("AuRo").disabled=document.getElementById("ROs").disabled=false;
    document.getElementById("AuBE").disabled=false;
    document.getElementById("bMx").disabled=document.getElementById("bMe").disabled=document.getElementById("bLw").disabled=false;
    document.getElementById("bMxs").disabled =document.getElementById("bMes").disabled=false;
  }

  if ( document.getElementById("AuBE").checked==true){
    document.getElementById("bMx").disabled=document.getElementById("bMe").disabled=document.getElementById("bLw").disabled=true;
    document.getElementById("bMxs").disabled =document.getElementById("bMes").disabled=true;
  }
  if( document.getElementById("AuRo").checked==false){
    document.getElementById("ROs").disabled=true;
  }
  if ( document.getElementById("ChEn").checked==false)
    document.getElementById("ChT").disabled=true;

  if (!%mqttPublishEnable% && parIn<2){
    alert("Display requires MQTT to be configured and active");
  }
}
</script>
<body>
  <button class="tablink" onclick="window.location.href='/';">Status</button> 
  <button class="tablink" onclick="window.location.href='/batt';">Battery</button>
  <button class="tablink" onclick="window.location.href='/graph';">Monitor</button>
  <button class="tablink" onclick="window.location.href='/config';" id="defaultOpen">Settings</button>
  <button class="tablink" onclick="window.location.href='/fwupgrade';">Upgrade</button>
  <div id="Settings" class="tabcontent"></div>
  <div style='margin:15px;'><br><center><b>REMOTE MQTT DISPLAY CONFIG</center></b>
  <center><font id="fwStat"></font></center><br> 
  <hr><br>
  <table style="width: 100&#37 border-collapse: collapse;" border="0">
  <tbody>
  <tr>
  <td style="width: 50&#37;">
  <form action="/get_oh" target="hidden-form">
    <span title="Enable TASMOTA DISPLAY">TASMOTA DISPLAY: <input type="checkBox" id="TaEn" name="TaEn" %TaEn% onclick="DoChecks(0);"></span><br>
    <span title="Enable OPENHASP DISPLAY">OPENHASP DISPLAY: <input type="checkBox" id="oHEn" name="oHEn" %oHEn% onclick="DoChecks(1);"></span><br><br>
    <span title="One display can show muliple BMS [1-99]">DashBoard ID: <input type="number"  maxlength="2"  min="1" max="99" size="2" name="DyPg" id="DyPg" value="%DyPg%" onchange="DoChecks(2)"></span><br>
    <span title="The name of this BMS">DashBoard NAME: <input type="text" name="DyMg" id="DyMg" value="%DyMg%" maxlength="10" size="10" ></span><br>
    <br><br>
    <table style="height: 139px; width: 45%%; border-collapse: collapse; border-style: none;" border="0">
      <tbody>
      <tr style="height: 21px;">
      <td style="width: 40%%; height: 21px;"><span title="Show Chart on display">Enable Chart</span></td>
      <td style="width: 20%%; text-align: right; height: 20px;"><input id="ChEn" type="checkBox" onclick="DoChecks(0);"/></td>
      <td style="width: 20%%; height: 20px;">&nbsp;</td>
      <td style="width: 20%%; height: 20px;">&nbsp;</td>
      </tr>
      <tr style="height: 21px;">
      <td style="width: 40%%; text-align: right; height: 21px;">Time Span [h]</td>
      <td style="width: 20%%; height: 21px;">&nbsp;</td>
      <td style="width: 20%%; height: 21px;"><input id="ChT" max="24" maxlength="2" min="1" max="24"type="number" value="1" /></td>
      <td style="width: 20%%; height: 21px;">&nbsp;</td>
      </tr>
      <tr style="height: 18px;">
      <td style="width: 40%%; text-align: right; height: 18px;">&nbsp;</td>
      <td style="width: 20%%; height: 18px;">&nbsp;</td>
      <td style="width: 20%%; height: 18px;">&nbsp;</td>
      <td style="width: 20%%; height: 18px;">&nbsp;</td>
      </tr>
      <tr style="height: 21px;">
      <td style="width: 40%%; height: 20px;"><span title="with multiple DashBoards - is the time to automatically move to next page">AutoRolling</span></td>
      <td style="width: 20%%; text-align: right; height: 20px;"><input id="AuRo" type="checkBox" onclick="DoChecks(0);"/></td>
      <td style="width: 20%%; height: 20px;">&nbsp;</td>
      <td style="width: 20%%; height: 20px;">&nbsp;</td>
      </tr>
      <tr style="height: 21px;">
      <td style="width: 40%%; text-align: right; height: 21px;">Period [s]</td>
      <td style="width: 20%%; height: 21px;">&nbsp;</td>
      <td style="width: 20%%; height: 21px;"><input id="ROs" max="255" maxlength="3" min="0" type="number" value="30" /></td>
      <td style="width: 20%%; height: 21px;">&nbsp;</td>
      </tr>
      <tr style="height: 18px;">
      <td style="width: 40%%; text-align: right; height: 18px;">&nbsp;</td>
      <td style="width: 20%%; height: 18px;">&nbsp;</td>
      <td style="width: 20%%; height: 18px;">&nbsp;</td>
      <td style="width: 20%%; height: 18px;">&nbsp;</td>
      </tr>
      <tr style="height: 20px;">
      <td style="width: 40%%; height: 20px;"><span title="use Brighness sensor to adjust Display brightess">AutoBrightness</span></td>
      <td style="width: 20%%; text-align: right; height: 20px;"><input id="AuBE" type="checkBox" onclick="DoChecks(0);"/></td>
      <td style="width: 20%%; height: 20px;">&nbsp;</td>
      <td style="width: 20%%; height: 20px;">&nbsp;</td>
      </tr>
      <tr style="height: 18px;">
      <td style="width: 40%%; height: 18px;">&nbsp;</td>
      <td style="width: 20%%; height: 18px;">Max</td>
      <td style="width: 20%%; height: 18px;">Med</td>
      <td style="width: 20%%; height: 18px;">Low</td>
      </tr>
      <tr style="height: 21px;">
      <td style="width: 40%%; text-align: right; height: 21px;"><span title="Brightness at the level [0-100]">Level [%%]&nbsp;</span></td>
      <td style="width: 20%%; height: 21px;"><input id="bMx" max="100" maxlength="3" min="0" size="3" type="number" value="100" /></td>
      <td style="width: 20%%; height: 21px;"><input id="bMe" max="100" maxlength="3" min="0" size="3" type="number" value="75" /></td>
      <td style="width: 20%%; height: 21px;"><input id="bLw" max="100" maxlength="3" min="0" size="3" type="number" value="20" /></td>
      </tr>
      <tr style="height: 21px;">
      <td style="width: 40%%; text-align: right; height: 21px;"><span title="How Long Brightness stays at the value in SECONDS">Period [s]&nbsp;</span></td>
      <td style="width: 20%%; height: 21px;"><input id="bMxs" max="3600" maxlength="3" min="0" size="3" type="number" value="120" /></td>
      <td style="width: 20%%; height: 21px;"><input id="bMes" max="3600" maxlength="3" min="0" size="3" type="number" value="60" /></td>
      <td style="width: 20%%; height: 21px;"><input max="1" maxlength="1" min="0" size="3" type="number" value="00" disabled="true"/></td>
      </tr>
    </tbody>
  </table>
  <br><br><input type="submit" value="Submit" onclick="submitMessage()"><br><br>  
  </form></td>
  <td style="width: 50&#37;"></td>
  </tr>
  </tbody>
  </table>
<hr><br>  
<div class="btn-group">
  <button onclick="window.location.href='config';">BACK to CONFIG</button>
  <button onclick = "downloadAllConfFile()">GENERATE openHASP CONFIG</button>
